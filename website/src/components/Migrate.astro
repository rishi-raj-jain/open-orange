---
// Migrating data without downtime, as orange migrate does it with the Durable
// Object Migrator. One scene, played in a loop while on screen and synced to
// the list of beats. Requests go through DNS to Cloudflare. The cutover is an
// edit to the DNS record: its target is retyped from cloudflare to
// openorange, and saving it throws the switch under it, so the live route
// turns orange and runs to OpenOrange. Each object is then copied the first
// time it is requested, and a backfill job copies the rest.
import Tip from '@/components/Tip.astro';
import { SITE } from '@/data/site';
import cloudflare from '@/assets/migrator/cloudflare.svg?raw';
import rivet from '@/assets/migrator/rivet-white.svg?raw';
import aws from '@/assets/migrator/aws.svg?raw';
import gcp from '@/assets/migrator/gcp.svg?raw';
import azure from '@/assets/migrator/azure.svg?raw';
import refresh from '@/assets/migrator/refresh-cw.svg?raw';
import globe from '@/assets/migrator/globe.svg?raw';
import users from '@/assets/migrator/users.svg?raw';

const inner = (svg: string) => svg.match(/<svg[^>]*>([\s\S]*)<\/svg>/)![1];
const vbox = (svg: string) => svg.match(/viewBox="([^"]+)"/)![1];
const lucide = (svg: string) => ['0 0 24 24', inner(svg).replace(/\s+/g, ' ').trim(), null];
const ICONS = {
	cf: [vbox(cloudflare), inner(cloudflare).replace('<title>Cloudflare</title>', ''), '#F6821F'],
	aws: [vbox(aws), inner(aws).replaceAll('#252F3E', 'var(--mig-aws)'), null],
	gcp: [vbox(gcp), inner(gcp), null],
	azure: [vbox(azure), inner(azure), null],
	rivet: ['0 0 128 128', inner(rivet).replace('#0F0F0F', '#1B1916'), null],
	users: lucide(users),
	globe: lucide(globe),
	refresh: lucide(refresh),
};

// Seconds each beat holds the scene.
const BEATS = [
	{ id: 'intro', dur: 3, title: 'Before', body: 'Every request goes to Cloudflare.' },
	{ id: 'cutover', dur: 3.4, title: 'Cutover', body: 'The DNS record now points at OpenOrange. New requests follow it.' },
	{ id: 'lazy', dur: 5.6, title: 'Lazy migration', body: "Each object is copied over the first time it's requested, then served from OpenOrange." },
	{ id: 'backfill', dur: 3.2, title: 'Backfill', body: 'A backfill job copies everything else.' },
	{ id: 'after', dur: 4.6, title: 'Zero downtime', body: 'Every request now runs on OpenOrange. The app stayed up the whole time.' },
];
const data = { icons: ICONS, beats: BEATS.map(({ id, dur }) => ({ id, dur })) };
---

<section id="migrate" class="scroll-mt-20 rule">
	<div class="container-x section">
		<div class="split-head">
			<h2 class="h-section">Migrate your data without downtime.</h2>
			<div class="lg:max-w-md">
				<p class="lede">
					orange migrate copies every Durable Object and
					<Tip tip="Cloudflare doesn't provide a way to migrate D1 live, so requests to a D1 database are interrupted while its data copies. This takes a few minutes.">D1<sup class="text-orange-deep">*</sup></Tip>
					database from Cloudflare while your app keeps serving. No maintenance window, no lost writes.
				</p>
				<p class="mt-4 text-[15px]"><a href={SITE.docsMigrate} class="link">Migration guide <span aria-hidden="true">→</span></a></p>
			</div>
		</div>

		<figure class="card mt-12 grid overflow-hidden md:mt-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" data-migrator>
			<ol class="flex flex-col border-b border-line lg:border-b-0 lg:border-r" aria-label="Migration steps">
				{BEATS.map((beat, i) => (
					<li class="flex-1 border-line [&:not(:first-child)]:border-t">
						<button
							type="button"
							data-beat={beat.id}
							aria-current={i === 0 ? 'step' : undefined}
							class="beat relative flex h-full w-full gap-4 px-6 py-4 text-left transition-colors hover:bg-paper-mid/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-orange motion-reduce:transition-none md:px-8 md:py-5"
						>
							<span class="num mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-current text-[12px] font-medium tabular-nums">{i + 1}</span>
							<span>
								<span class="title block text-[15px] font-semibold">{beat.title}</span>
								<span class="body mt-1 block text-[14px] leading-relaxed">{beat.body}</span>
							</span>
							<span class="progress absolute bottom-0 left-0 h-[2px] bg-orange" aria-hidden="true"></span>
						</button>
					</li>
				))}
			</ol>
			<div class="flex items-center bg-paper px-3 py-5 sm:px-5 md:p-8">
				<svg viewBox="0 0 600 420" class="block h-auto w-full" role="img" aria-label="Requests go through DNS to Cloudflare. The DNS record is changed to point at OpenOrange and requests follow it. Each object is copied to OpenOrange on its first request, and a backfill job copies the rest." data-scene></svg>
			</div>
			<script type="application/json" data-migrator-data set:html={JSON.stringify(data)} />
		</figure>
	</div>
</section>

<style>
	.beat .num,
	.beat .title,
	.beat .body {
		color: var(--color-ink-faint);
		transition: color 0.2s;
	}
	.beat[aria-current='step'] {
		background: var(--color-paper-mid);
	}
	.beat[aria-current='step'] .num,
	.beat[aria-current='step'] .title {
		color: var(--color-ink);
	}
	.beat[aria-current='step'] .body {
		color: var(--color-ink-soft);
	}
	.beat:not([aria-current='step']) .progress {
		width: 0 !important;
	}
	/* Scene colors beyond the site tokens: wires a step darker than a hairline,
	   and the route before cutover. The script draws with these and the tokens,
	   so the scene follows the theme. */
	[data-migrator] {
		--mig-wire: #d6d3d1;
		--mig-route: #57534e;
		--mig-aws: #252f3e;
	}
	:global(.dark) [data-migrator] {
		--mig-wire: #3d3935;
		--mig-route: #a8a29e;
		--mig-aws: #e8e6e3;
	}
</style>

<style is:global>
	[data-scene] text {
		font-family: var(--font-sans);
	}
	[data-scene] .mono {
		font-family: var(--font-mono);
	}
	[data-scene] .caps {
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
</style>

<script>
	type Icon = [string, string, string | null];
	type Box = { x: number; y: number; w: number; h: number };
	type Layout = ReturnType<typeof layout>;

	// Two drawings of the same scene: wide, and narrow for phones, each about
	// one viewBox unit per CSS pixel so the type matches the page.
	function layout(narrow: boolean) {
		const W = narrow ? 360 : 600;
		const CX = W / 2;
		const m = narrow ? 12 : 24;
		const users = { x: CX - 48, y: 8, w: 96, h: 30 };
		const dns = narrow ? { x: m, y: 70, w: W - 2 * m, h: 70 } : { x: CX - 190, y: 74, w: 380, h: 70 };
		const JY = dns.y + dns.h + 38;
		const gap = narrow ? 40 : 84;
		const bw = (W - 2 * m - gap) / 2;
		const T = narrow ? 34 : 42, G = narrow ? 8 : 12;
		const head = 40, pad = narrow ? 16 : 20;
		const bh = head + pad + 2 * T + G + pad;
		const by = JY + 36;
		const cf = { x: m, y: by, w: bw, h: bh }, nw = { x: W - m - bw, y: by, w: bw, h: bh };
		// The record's columns, from the mono advance (0.6em): name, type, target.
		const fs = narrow ? 11.5 : 12.5, cw = fs * 0.6, col = narrow ? 10 : 18;
		const nameX = dns.x + (narrow ? 12 : 14), typeX = nameX + 15 * cw + col, fieldX = typeX + 5 * cw + col;
		const field = { x: fieldX, y: dns.y + 40, w: dns.x + dns.w - (narrow ? 10 : 14) - fieldX, h: 22 };
		const bfy = by + head + pad + T + G / 2;
		return {
			narrow, W, H: by + bh + (narrow ? 26 : 8), CX, users, dns, JY, cf, nw, T, G, head, pad, fs, cw, field, nameX, typeX,
			// The backfill job sits between the boxes; on phones its label goes under them.
			bf: { x: CX, y: bfy, r: narrow ? 12 : 14, labelY: narrow ? by + bh + 16 : bfy + 29 },
			pulse: narrow ? 6 : 10,
			dot: narrow ? 6 : 7,
			speed: narrow ? 300 : 420,
		};
	}

	const NS = 'http://www.w3.org/2000/svg';
	const ORANGE = '#F26B1D';
	const INK = 'var(--color-ink)', SOFT = 'var(--color-ink-soft)', FAINT = 'var(--color-ink-faint)';
	const LINE = 'var(--color-line)', WIRE = 'var(--mig-wire)', ROUTE = 'var(--mig-route)';
	const SURFACE = 'var(--color-surface)', PAPER = 'var(--color-paper)', MID = 'var(--color-paper-mid)';
	const OSOFT = 'var(--color-orange-soft)', ODEEP = 'var(--color-orange-deep)';
	const LETTERS = 'ABCDEF';

	const inOut = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
	const out = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : 1 - Math.pow(1 - x, 3));
	const clamp = (x: number) => Math.min(1, Math.max(0, x));
	const lerp = (a: number, b: number, k: number) => a + (b - a) * k;

	for (const fig of document.querySelectorAll<HTMLElement>('[data-migrator]')) {
		const { icons: ICONS, beats } = JSON.parse(fig.querySelector('[data-migrator-data]')!.textContent!) as {
			icons: Record<string, Icon>;
			beats: { id: string; dur: number }[];
		};
		const svg = fig.querySelector<SVGSVGElement>('[data-scene]')!;
		const buttons = Array.from(fig.querySelectorAll<HTMLButtonElement>('[data-beat]'));

		// Timeline in seconds.
		const ORDER = beats.map((b) => b.id), PAUSE = 0.4;
		const B: Record<string, number> = {}, DUR: Record<string, number> = {};
		let acc = 0;
		for (const b of beats) { B[b.id] = acc; DUR[b.id] = b.dur; acc += b.dur + PAUSE; }
		const END = acc + 0.4;
		const C = B.cutover, LZ = B.lazy, BF = B.backfill, AFTER = B.after;
		// The DNS edit: focus the target, select it, clear it, type the new one,
		// save. Saving throws the switch.
		const NEW = 'openorange', OLD = 'cloudflare', KEY = 0.07;
		const FOCUS = C + 0.2, SELECT = C + 0.5, CLEAR = C + 0.95, TYPE = C + 1.05;
		const FLIP = TYPE + NEW.length * KEY + 0.3;
		const MOVE = 0.8, FAST = 0.3, MED = 0.6;
		const moves = [
			{ i: 0, t: LZ + 0.3, bf: false }, { i: 2, t: LZ + 2, bf: false }, { i: 4, t: LZ + 3.6, bf: false },
			{ i: 1, t: BF + 0.5, bf: true }, { i: 3, t: BF + 1.1, bf: true }, { i: 5, t: BF + 1.7, bf: true },
		];
		const mv = (i: number) => moves.find((m) => m.i === i)!;

		let L: Layout;
		let draw: (t: number) => void = () => {};

		const build = (narrow: boolean) => {
			L = layout(narrow);
			const { W, H, CX, users, dns, JY, cf, nw, T, G, head, pad, fs, field, bf } = L;
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			svg.replaceChildren();
			const el = (tag: string, a: Record<string, string | number>, p: Element = svg) => {
				const e = document.createElementNS(NS, tag) as SVGGraphicsElement & SVGGeometryElement;
				for (const k in a) e.setAttribute(k, String(a[k]));
				p.appendChild(e);
				return e;
			};
			const text = (s: string, a: Record<string, string | number>, p?: Element) => {
				const e = el('text', a, p);
				e.textContent = s;
				return e;
			};
			const icon = (name: string, x: number, y: number, size: number, p: Element, stroke?: string) => {
				const [vb, body, fill] = ICONS[name];
				const s = el('svg', { x, y, width: size, height: size, viewBox: vb }, p);
				if (stroke) {
					for (const [k, v] of Object.entries({ fill: 'none', stroke, 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' })) s.setAttribute(k, String(v));
				} else if (fill) s.setAttribute('fill', fill);
				s.innerHTML = body;
				return s;
			};
			const logo = (x: number, y: number, size: number, p: Element) => el('image', { href: '/images/logo.png', x, y, width: size, height: size }, p);
			const slot = (b: Box, i: number) => {
				const gw = 3 * T + 2 * G;
				return { x: b.x + (b.w - gw) / 2 + (i % 3) * (T + G), y: b.y + head + pad + Math.floor(i / 3) * (T + G) };
			};
			const center = (b: Box, i: number) => { const s = slot(b, i); return { x: s.x + T / 2, y: s.y + T / 2 }; };
			const bx = (b: Box) => b.x + b.w / 2;
			const R = 12;
			const branch = (b: Box, endY: number) => {
				const x = bx(b), dir = Math.sign(x - CX);
				return `M${CX} ${JY} H${x - dir * R} Q${x} ${JY} ${x} ${JY + R} V${endY}`;
			};
			const cw = L.cw;

			// Wires: the inactive ones dashed, the live route drawn over them.
			const wires = el('g', { fill: 'none', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' });
			const trunk = `M${CX} ${users.y + users.h} V${JY}`;
			el('path', { d: trunk, stroke: WIRE, 'stroke-width': 1.5 }, wires);
			for (const b of [cf, nw]) el('path', { d: branch(b, b.y), stroke: WIRE, 'stroke-width': 1.5, 'stroke-dasharray': '3 5' }, wires);
			const trunkOld = el('path', { d: trunk, stroke: ROUTE, 'stroke-width': 2 }, wires);
			const trunkNew = el('path', { d: trunk, stroke: ORANGE, 'stroke-width': 2 }, wires);
			const toCf = el('path', { d: branch(cf, cf.y), stroke: ROUTE, 'stroke-width': 2 }, wires);
			const toNw = el('path', { d: branch(nw, nw.y), stroke: ORANGE, 'stroke-width': 2 }, wires);
			const lCf = toCf.getTotalLength(), lNw = toNw.getTotalLength();
			toCf.setAttribute('stroke-dasharray', `${lCf} ${lCf}`);
			toNw.setAttribute('stroke-dasharray', `${lNw} ${lNw}`);

			// The switch under DNS: an arm on a pivot that points down the live branch.
			const arm = el('line', { x1: CX, y1: JY, x2: CX - 18, y2: JY, 'stroke-width': 3, 'stroke-linecap': 'round' });
			el('circle', { cx: CX, cy: JY, r: 4, fill: SURFACE, stroke: ROUTE, 'stroke-width': 1.5 });

			// Users.
			el('rect', { x: users.x, y: users.y, width: users.w, height: users.h, rx: users.h / 2, fill: SURFACE, stroke: LINE });
			icon('users', users.x + 16, users.y + 8, 14, svg, SOFT);
			text('Users', { x: users.x + 36, y: users.y + 19.5, 'font-size': 13, 'font-weight': 500, fill: INK });

			// The DNS record.
			el('rect', { x: dns.x, y: dns.y, width: dns.w, height: dns.h, rx: 10, fill: SURFACE, stroke: LINE });
			icon('globe', dns.x + 14, dns.y + 10, 13, svg, FAINT);
			text('DNS record', { x: dns.x + 33, y: dns.y + 20.5, 'font-size': 11, 'font-weight': 600, fill: FAINT, class: 'caps' });
			const ttl = text('TTL 60', { x: dns.x + dns.w - 14, y: dns.y + 20.5, 'font-size': 11, fill: FAINT, 'text-anchor': 'end', class: 'mono' });
			el('line', { x1: dns.x, x2: dns.x + dns.w, y1: dns.y + 31.5, y2: dns.y + 31.5, stroke: LINE });
			const rowY = field.y + 15.5;
			text('app.example.com', { x: L.nameX, y: rowY, 'font-size': fs, fill: INK, class: 'mono' });
			text('CNAME', { x: L.typeX, y: rowY, 'font-size': fs, fill: FAINT, class: 'mono' });
			const pulse = el('rect', { rx: 8, fill: 'none', stroke: ORANGE, 'stroke-width': 1.5, opacity: 0 });
			const fieldBox = el('rect', { x: field.x, y: field.y, width: field.w, height: field.h, rx: 5, 'stroke-width': 1 });
			const ring = el('rect', { x: field.x - 2, y: field.y - 2, width: field.w + 4, height: field.h + 4, rx: 7, fill: 'none', stroke: ORANGE, 'stroke-width': 1.5, opacity: 0 });
			const glyphCf = icon('cf', field.x + 7, field.y + 5, 14, svg);
			const glyphNew = logo(field.x + 7, field.y + 4, 14, svg);
			const tx = field.x + 28;
			const sel = el('rect', { x: tx - 1, y: field.y + 4, height: 14, rx: 2, fill: ORANGE, 'fill-opacity': 0.25 });
			const value = text('', { x: tx, y: rowY, 'font-size': fs, class: 'mono' });
			const caret = el('rect', { y: field.y + 4, width: 1.5, height: 14, fill: INK });

			// Cloudflare and OpenOrange.
			const box = (b: Box, name: string) => {
				const g = el('g', {});
				const frame = el('rect', { x: b.x, y: b.y, width: b.w, height: b.h, rx: 12, fill: SURFACE, stroke: LINE }, g);
				if (name === 'Cloudflare') icon('cf', b.x + 14, b.y + 12, 17, g); else logo(b.x + 14, b.y + 11, 18, g);
				text(name, { x: b.x + 38, y: b.y + 25, 'font-size': 13, 'font-weight': 600, fill: INK }, g);
				el('line', { x1: b.x, x2: b.x + b.w, y1: b.y + head - 0.5, y2: b.y + head - 0.5, stroke: LINE }, g);
				for (let i = 0; i < 6; i++) {
					const s = slot(b, i);
					el('rect', { x: s.x + 0.5, y: s.y + 0.5, width: T - 1, height: T - 1, rx: 8, fill: 'none', stroke: WIRE, 'stroke-dasharray': '3 4' }, g);
				}
				return { g, frame };
			};
			const cfBox = box(cf, 'Cloudflare');
			const nwBox = box(nw, 'OpenOrange');
			// Where OpenOrange runs, on the wide drawing.
			if (!L.narrow) (['aws', 'gcp', 'azure', 'rivet'] as const).forEach((n, i) => icon(n, nw.x + nw.w - 14 - 14 * 4 - 8 * 3 + i * 22, nw.y + 13, 14, nwBox.g));
			const nwGlow = el('rect', { x: nw.x - 0.5, y: nw.y - 0.5, width: nw.w + 1, height: nw.h + 1, rx: 12.5, fill: 'none', stroke: ORANGE, 'stroke-width': 1.5, opacity: 0 });

			// What Cloudflare still holds once an object is copied: a stale copy.
			const ghosts = Array.from({ length: 6 }, (_, i) => {
				const s = slot(cf, i);
				const g = el('g', { opacity: 0 }, cfBox.g);
				el('rect', { x: s.x + 0.5, y: s.y + 0.5, width: T - 1, height: T - 1, rx: 8, fill: 'none', stroke: FAINT, 'stroke-opacity': 0.5, 'stroke-dasharray': '3 4' }, g);
				text(LETTERS[i], { x: s.x + T / 2, y: s.y + T / 2 + 5, 'font-size': L.narrow ? 13 : 15, 'font-weight': 500, 'text-anchor': 'middle', fill: FAINT, 'fill-opacity': 0.6, class: 'mono' }, g);
				return g;
			});

			// The backfill job, between the two, wired to both.
			const bfG = el('g', { opacity: 0 });
			const bfWires = el('path', { d: `M${cf.x + cf.w} ${bf.y} H${bf.x - bf.r} M${bf.x + bf.r} ${bf.y} H${nw.x}`, stroke: ORANGE, 'stroke-width': 1.5, 'stroke-dasharray': '2 4', fill: 'none' }, bfG);
			el('circle', { cx: bf.x, cy: bf.y, r: bf.r, fill: 'var(--color-plate)' }, bfG);
			const bfIcon = el('g', {}, bfG);
			icon('refresh', bf.x - bf.r * 0.5, bf.y - bf.r * 0.5, bf.r, bfIcon, '#f5f5f4');
			text('backfill', { x: bf.x, y: bf.labelY, 'font-size': 11, 'text-anchor': 'middle', fill: FAINT, class: 'mono' }, bfG);

			const fx = el('g', {}), tilesG = el('g', {}), dots = el('g', {}), waits = el('g', {});
			const tiles = Array.from({ length: 6 }, (_, i) => {
				const g = el('g', {}, tilesG);
				const base = el('rect', { width: T, height: T, rx: 8, fill: MID, stroke: WIRE }, g);
				const lit = el('rect', { width: T, height: T, rx: 8, fill: ORANGE }, g);
				const letter = text(LETTERS[i], { x: T / 2, y: T / 2 + 5, 'font-size': L.narrow ? 13 : 15, 'font-weight': 600, 'text-anchor': 'middle', class: 'mono' }, g);
				return { g, base, lit, letter };
			});

			// Requests, from Users through DNS to an object.
			type Req = { t: number; i: number; to: 'cf' | 'nw'; hold?: number };
			const reqs: Req[] = [];
			const rnd = (() => { let s = 7; return () => (s = (s * 9301 + 49297) % 233280) / 233280; })();
			const toJ = (JY - users.y - users.h) / L.speed;
			for (let t = -1.4; t < FLIP - toJ - 0.1; t += 0.42) reqs.push({ t, i: Math.floor(rnd() * 6), to: 'cf' });
			// The first request after cutover is for A: it waits at OpenOrange while A copies.
			for (const m of moves.slice(0, 3)) reqs.push({ t: m.i === 0 ? FLIP + 0.35 : m.t - 0.9, i: m.i, to: 'nw', hold: m.t + MOVE });
			for (let t = LZ + 1.4; t < END - 0.6; t += 0.42) {
				const done = [0, 1, 2, 3, 4, 5].filter((i) => mv(i).t + MOVE < t + 0.6);
				if (done.length) reqs.push({ t, i: done[Math.floor(rnd() * done.length)], to: 'nw' });
			}
			const routes: Record<string, { p: SVGGeometryElement; len: number; hold: number }> = {};
			const route = (q: Req) => {
				const k = q.to + q.i;
				if (routes[k]) return routes[k];
				const b = q.to === 'cf' ? cf : nw, c = center(b, q.i), hy = b.y - 14;
				const pre = `${trunk} ${branch(b, hy).replace(/^M[^H]+/, '')}`;
				const p = el('path', { d: `${pre} V${b.y + head / 2} L${c.x} ${c.y}`, fill: 'none', stroke: 'none' });
				const hp = el('path', { d: pre, fill: 'none', stroke: 'none' });
				return (routes[k] = { p, len: p.getTotalLength(), hold: hp.getTotalLength() });
			};

			draw = (t: number) => {
				// The DNS edit.
				const editing = t >= FOCUS && t < FLIP + 0.35;
				ring.setAttribute('opacity', String(editing ? out((t - FOCUS) / 0.2) : 0));
				const saved = t >= FLIP;
				fieldBox.setAttribute('fill', saved ? OSOFT : MID);
				fieldBox.setAttribute('stroke', saved ? 'none' : LINE);
				glyphCf.setAttribute('opacity', saved ? '0' : '1');
				glyphNew.setAttribute('opacity', saved ? '1' : '0');
				let s = OLD;
				if (t >= CLEAR) s = NEW.slice(0, Math.max(0, Math.min(NEW.length, Math.floor((t - TYPE) / KEY) + 1)));
				value.textContent = s;
				value.setAttribute('fill', saved ? ODEEP : INK);
				value.setAttribute('font-weight', saved ? '600' : '400');
				const sk = t >= SELECT && t < CLEAR ? out((t - SELECT) / 0.3) : 0;
				sel.setAttribute('width', String(OLD.length * cw * sk + 2));
				sel.setAttribute('opacity', sk > 0 ? '1' : '0');
				caret.setAttribute('x', String(tx + s.length * cw + 0.5));
				caret.setAttribute('opacity', editing && !saved && sk === 0 && (t >= CLEAR || Math.floor((t - FOCUS) * 2.5) % 2 === 0) ? '1' : '0');
				const pk = (t - FLIP) / 0.7;
				if (pk > 0 && pk < 1) {
					const g = 3 + out(pk) * (L.pulse - 3);
					pulse.setAttribute('x', String(field.x - g)); pulse.setAttribute('y', String(field.y - g));
					pulse.setAttribute('width', String(field.w + 2 * g)); pulse.setAttribute('height', String(field.h + 2 * g));
					pulse.setAttribute('opacity', String(1 - pk));
				} else pulse.setAttribute('opacity', '0');
				ttl.textContent = saved && t < FLIP + 1.8 ? 'saved' : 'TTL 60';
				ttl.setAttribute('fill', saved && t < FLIP + 1.8 ? ODEEP : FAINT);

				// Saving throws the switch: the live route swings to OpenOrange and turns orange.
				const f = inOut((t - FLIP) / MED);
				const a = Math.PI * (1 - inOut((t - FLIP) / 0.45));
				arm.setAttribute('x2', String(CX + 18 * Math.cos(a)));
				arm.setAttribute('y2', String(JY + 18 * Math.sin(a)));
				arm.setAttribute('stroke', a < Math.PI / 2 ? ORANGE : ROUTE);
				trunkNew.setAttribute('opacity', String(f));
				trunkOld.setAttribute('opacity', String(1 - f));
				toCf.setAttribute('stroke-dashoffset', String(-lCf * f));
				toNw.setAttribute('stroke-dashoffset', String(lNw * (1 - f)));
				nwGlow.setAttribute('opacity', String(0.55 * f * (1 - out((t - AFTER) / MED))));

				cfBox.g.setAttribute('opacity', String(1 - 0.55 * out((t - (AFTER + 0.3)) / MED)));
				bfG.setAttribute('opacity', String(out((t - BF) / FAST) * (1 - out((t - AFTER) / FAST))));
				bfIcon.setAttribute('transform', `rotate(${t * 240} ${bf.x} ${bf.y})`);
				bfWires.setAttribute('stroke-dashoffset', String(-t * 18));

				// Objects copy left to right; backfilled ones pass through the job.
				fx.replaceChildren();
				for (let i = 0; i < 6; i++) {
					const m = mv(i), a0 = slot(cf, i), b0 = slot(nw, i), tl = tiles[i];
					const raw = (t - m.t) / MOVE, k = inOut(raw);
					let x = lerp(a0.x, b0.x, k), y = lerp(a0.y, b0.y, k) - Math.sin(k * Math.PI) * 26;
					let sc = 1 + Math.sin(k * Math.PI) * 0.06;
					if (m.bf) {
						const mid = { x: bf.x - T / 2, y: bf.y - T / 2 };
						if (k < 0.5) { const kk = inOut(k * 2); x = lerp(a0.x, mid.x, kk); y = lerp(a0.y, mid.y, kk); sc = lerp(1, 0.45, kk); }
						else { const kk = inOut((k - 0.5) * 2); x = lerp(mid.x, b0.x, kk); y = lerp(mid.y, b0.y, kk); sc = lerp(0.45, 1, kk); }
					}
					tl.g.setAttribute('transform', `translate(${x + T / 2} ${y + T / 2}) scale(${sc}) translate(${-T / 2} ${-T / 2})`);
					const lit = clamp((k - 0.3) / 0.4);
					tl.lit.setAttribute('opacity', String(lit));
					tl.base.setAttribute('stroke-opacity', String(1 - lit));
					tl.letter.setAttribute('fill', lit > 0.5 ? '#fff' : SOFT);
					ghosts[i].setAttribute('opacity', raw > 0 ? '1' : '0');
					if (raw > 0 && raw < 1) tilesG.appendChild(tl.g);
					const land = (t - (m.t + MOVE)) / MED;
					if (land > 0 && land < 1) {
						const c = center(nw, i), r = T / 2 + 2 + out(land) * 10;
						el('rect', { x: c.x - r, y: c.y - r, width: 2 * r, height: 2 * r, rx: 10, fill: 'none', stroke: ORANGE, 'stroke-width': 1.5, opacity: 1 - land }, fx);
					}
				}

				// Requests. They pass behind the DNS record: that is the lookup.
				dots.replaceChildren();
				waits.replaceChildren();
				for (const q of reqs) {
					const r = route(q);
					let d = (t - q.t) * L.speed, waiting = false;
					if (d < 0) continue;
					if (q.hold) {
						const arrive = q.t + r.hold / L.speed;
						if (t >= arrive) {
							if (t < q.hold) { d = r.hold; waiting = true; }
							else d = r.hold + (t - q.hold) * L.speed;
						}
					}
					if (d >= r.len) {
						const k = (d - r.len) / 260;
						if (k > 1) continue;
						const c = center(q.to === 'cf' ? cf : nw, q.i), rr = T / 2 + 1 + k * 8;
						el('rect', { x: c.x - rr, y: c.y - rr, width: 2 * rr, height: 2 * rr, rx: 10, fill: 'none', stroke: INK, 'stroke-width': 1.25, opacity: 0.4 * (1 - k) }, dots);
						continue;
					}
					const p = r.p.getPointAtLength(d);
					// A request waiting for its object draws over the ones passing it.
					const layer = waiting ? waits : dots;
					// Behind the DNS record (the lookup) and a box's header (its front door).
					if (p.y > dns.y - 2 && p.y < dns.y + dns.h + 2) continue;
					if (p.y > cf.y - L.dot && p.y < cf.y + head + L.dot) continue;
					el('circle', { cx: p.x, cy: p.y, r: L.dot, fill: INK }, layer);
					text(LETTERS[q.i], { x: p.x, y: p.y + L.dot * 0.48, 'font-size': L.dot * 1.35, 'font-weight': 700, 'text-anchor': 'middle', fill: PAPER, class: 'mono' }, layer);
					if (waiting) el('circle', { cx: p.x, cy: p.y, r: L.dot + 4.5, fill: 'none', stroke: ORANGE, 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-dasharray': `${L.dot * 2.2} 100`, transform: `rotate(${t * 420} ${p.x} ${p.y})` }, layer);
				}
			};
		};

		// The list of beats follows the timeline.
		const sync = (t: number) => {
			let beat = ORDER[0];
			for (const k of ORDER) if (t >= B[k]) beat = k;
			const i = ORDER.indexOf(beat);
			const next = i + 1 < ORDER.length ? B[ORDER[i + 1]] : END;
			for (const btn of buttons) {
				const on = btn.dataset.beat === beat;
				if (on) btn.setAttribute('aria-current', 'step'); else btn.removeAttribute('aria-current');
				if (on) btn.querySelector<HTMLElement>('.progress')!.style.width = `${Math.min(1, (t - B[beat]) / (next - B[beat])) * 100}%`;
			}
		};
		const render = (t: number) => { draw(t); sync(t); };

		// Play in a loop while on screen. Picking a beat jumps to it. Without
		// motion, each beat shows a settled frame from late in it.
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const settled = (k: string) => (k === 'intro' ? B.intro + 1 : k === 'cutover' ? FLIP + 1 : B[k] + DUR[k] * 0.9);
		let t = reduced ? settled('lazy') : 0, last = 0, visible = false, raf = 0;
		const frame = (now: number) => {
			if (last) t += Math.min(0.1, (now - last) / 1000);
			last = now;
			if (t >= END) t = 0;
			render(t);
			raf = visible ? requestAnimationFrame(frame) : 0;
		};
		const play = () => { if (!raf && !reduced) { last = 0; raf = requestAnimationFrame(frame); } };
		for (const btn of buttons)
			btn.addEventListener('click', () => {
				const k = btn.dataset.beat!;
				t = reduced ? settled(k) : B[k];
				render(t);
			});

		let narrow: boolean | undefined;
		const fit = () => {
			const n = svg.getBoundingClientRect().width < 460;
			if (n === narrow) return;
			narrow = n;
			build(n);
			render(t);
		};
		fit();
		new ResizeObserver(fit).observe(svg);
		new IntersectionObserver(([e]) => {
			visible = e.isIntersecting;
			if (visible) play();
		}).observe(svg);
	}
</script>
