---
// Cloudflare's memory cap, struck through, then every limit side by side.
// The strike draws when the section scrolls into view. Without JS or with
// reduced motion it is already drawn.
import { LIMITS } from '@/data/site';

const memory = LIMITS.find((row) => row.id === 'memory')!;
---

<section id="limits" class="scroll-mt-20 rule">
	<div class="container-x section">
		<div class="grid gap-6 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-end lg:gap-12">
			<p class="strike relative justify-self-start whitespace-nowrap font-medium leading-[0.9] tracking-[-0.05em] text-ink-faint tabular-nums" aria-hidden="true" data-strike>{memory.cloudflare}</p>
			<div class="lg:pb-1.5">
				<h2 class="h-section">No runtime limits.</h2>
				<p class="lede mt-4 max-w-xl">{memory.cloudflare} is all the memory a Cloudflare Worker gets. OpenOrange runs your Workers and Durable Objects on machines you choose, so the limits are your hardware's.</p>
			</div>
		</div>

		<div class="card mt-12 px-5 pb-2 pt-5 md:px-6">
			<table class="limits w-full text-[15px]">
				<thead>
					<tr>
						<th class="w-[34%]">Limit</th>
						<th class="w-[30%]">Cloudflare<span class="max-sm:hidden"> Workers Paid</span></th>
						<th class="text-orange-deep">OpenOrange</th>
					</tr>
				</thead>
				<tbody>
					{LIMITS.map((row) => (
						<tr>
							<td class="font-medium">{row.limit}</td>
							<td class="font-mono text-[13px] text-ink-faint"><s class="decoration-ink-faint/70">{row.cloudflare}</s></td>
							<td class="font-semibold">
								{row.openorange}
								{row.note ? <span class="block text-[13px] font-normal text-ink-faint">{row.note}</span> : null}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<p class="caption mt-4">Workers Paid plan, from <a href="https://developers.cloudflare.com/workers/platform/limits/" class="underline decoration-ink-faint/40 underline-offset-2 hover:text-ink">Cloudflare's docs</a>. Free plan limits are stricter.</p>
	</div>
</section>

<style>
	.strike {
		font-size: clamp(4.5rem, 16vw, 9.5rem);
	}
	.strike::after {
		content: '';
		position: absolute;
		left: -2%;
		right: -2%;
		top: 52%;
		height: 0.075em;
		border-radius: 999px;
		background: var(--color-orange);
		transform: rotate(-4deg);
		transform-origin: left center;
	}
	/* Armed on load and drawn once the number is on screen. */
	.strike[data-armed]::after {
		transform: rotate(-4deg) scaleX(0);
	}
	.strike[data-armed][data-go]::after {
		transform: rotate(-4deg) scaleX(1);
		transition: transform 0.55s 0.15s cubic-bezier(0.6, 0, 0.2, 1);
	}

	.limits th {
		padding: 0 1rem 0.625rem 0;
		border-bottom: 1px solid var(--color-line);
		text-align: left;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.limits th:not(.text-orange-deep) {
		color: var(--color-ink-faint);
	}
	.limits td {
		padding: 0.8rem 1rem 0.8rem 0;
		border-bottom: 1px solid var(--color-line);
		vertical-align: baseline;
	}
	.limits tbody tr:last-child td {
		border-bottom: 0;
	}
	/* Phones: the limit on its own line, then the two values side by side
	   under a two-column header. */
	@media (max-width: 639px) {
		.limits tr {
			display: grid;
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			column-gap: 0.75rem;
		}
		.limits th,
		.limits td {
			width: auto;
			padding: 0;
			border: 0;
		}
		.limits thead tr {
			padding-bottom: 0.625rem;
			border-bottom: 1px solid var(--color-line);
		}
		.limits th:first-child {
			display: none;
		}
		.limits tbody tr {
			padding: 0.75rem 0;
			border-bottom: 1px solid var(--color-line);
		}
		.limits tbody tr:last-child {
			border-bottom: 0;
		}
		.limits td:first-child {
			grid-column: 1 / -1;
			margin-bottom: 0.25rem;
		}
	}
</style>

<script>
	const strike = document.querySelector<HTMLElement>('[data-strike]');
	if (strike && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		strike.toggleAttribute('data-armed', true);
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				strike.toggleAttribute('data-go', true);
				io.disconnect();
			},
			{ threshold: 0.6 },
		);
		io.observe(strike);
	}
</script>
