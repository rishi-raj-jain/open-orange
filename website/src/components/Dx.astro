		font: 0.89em / 1.76 var(--font-mono);
	}
	.pp-t {
		margin-top: 0.15em;
		padding: 0 0.5em;
		border: 1px solid rgb(2 142 107 / 0.22);
		border-radius: 0.4em;
		background: #fff;
		color: var(--pp-ink);
		font-size: 0.88em;
