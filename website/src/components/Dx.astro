			opacity: 0;
		}
	}
	/* A block cursor covers the cell after the last character, as in a real
	   terminal: the negative margin cancels its width, so typing never pushes
	   the rest of the line along by an extra cell. */
	.dx-caret {
		display: inline-block;
		width: 1ch;
