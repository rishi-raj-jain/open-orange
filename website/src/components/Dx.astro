	}

	/* A phone-sized window: no sidebar, tighter margins. */
	@container (max-width: 520px) {
		.pp-main {
			grid-template-columns: minmax(0, 1fr);
		}
		.pp-side {
			display: none;
		}
		.pp-top {
			padding-right: 0.7em;
		}
		.pp-flow {
			gap: 1.2em;
			padding: 1.3em 1.1em 0.5em;
		}
		.pp-composer {
