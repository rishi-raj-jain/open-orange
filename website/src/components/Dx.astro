			0 0 0 0.5px #000,
			0 26px 64px -10px rgb(0 0 0 / 0.8);
	}
	.dx-browser[data-open] {
		visibility: visible;
	}
	/* Safari's toolbar: the lights, the sidebar and history buttons, and the
	   address field centered in the window. The page stays light; the toolbar
	   follows the system appearance. */
	.dx-browser .dx-bar {
		flex: none;
		grid-template-columns: minmax(10.5rem, 1fr) minmax(0, 22rem) minmax(10.5rem, 1fr);
		height: 40px;
		padding: 0 12px 0 14px;
		background: linear-gradient(#f9f8f7, #efedeb);
