		--pp-line: #ebedef;
		--pp-line-2: #dcdfe3;
		--pp-text: #16191d;
		--pp-text-2: #454c54;
		--pp-muted: #80878f;
		position: absolute;
		inset: 0;
		display: none;
		grid-template-rows: 3.3em minmax(0, 1fr);
		background: #fff;
		color: var(--pp-text);
		font: 400 clamp(10px, 1.6cqi, 12.5px) / 1.57 var(--font-sans);
		letter-spacing: 0;
