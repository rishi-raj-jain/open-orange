	}
	.pp-a {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.pp-tool:not([data-done]) .pp-s::before {
		content: '';
		display: inline-block;
		width: 0.8em;
		height: 0.8em;
		border: 0.12em solid var(--pp-brand);
		border-top-color: transparent;
		border-radius: 50%;
		vertical-align: -0.05em;
		animation: pp-spin 0.8s linear infinite;
	}
	.pp-out {
		margin: 0.45em 0;
		padding: 0.7em 1em;
		overflow: hidden;
		border: 1px solid var(--pp-line);
		border-radius: 0.57em;
		background: #fff;
		font: 0.86em / 1.5 var(--font-mono);
		white-space: pre;
	}
	.pp-answer p {
		margin-bottom: 0.7em;
		overflow-wrap: anywhere;
	}
	.pp-answer p:last-child {
		margin-bottom: 0;
	}
	.pp-answer b {
		font-weight: 600;
	}
	.pp-answer code {
		padding: 0 0.36em;
		border: 1px solid var(--pp-line);
