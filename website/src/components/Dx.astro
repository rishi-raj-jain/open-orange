	}
	@media (prefers-reduced-motion: reduce) {
		.pp *,
		.pp *::before,
		.pp *::after {
			animation: none !important;
		}
	}

	/* The pointer. Its box is the hot spot, so a click can shrink it in place
	   and the arrow and the hand can swap without moving it. */
	.dx-cursor {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 40;
		pointer-events: none;
		will-change: translate;
	}
	.dx-cursor-icon {
		position: absolute;
		transform-origin: 0 0;
	}
	.dx-cursor svg {
		position: absolute;
		width: 28px;
		height: 28px;
		filter: drop-shadow(0 1px 1.2px rgb(0 0 0 / 0.45));
	}
	.dx-cursor .dx-arrow {
		left: -8.5px;
		top: -5px;
	}
	.dx-cursor .dx-hand {
		display: none;
		left: -9.6px;
		top: -3.6px;
	}
	.dx-cursor[data-hand] .dx-arrow {
		display: none;
	}
	.dx-cursor[data-hand] .dx-hand {
		display: block;
	}
	/* Where a click lands. */
	.dx-ripple {
		position: absolute;
		z-index: 39;
		width: 30px;
		height: 30px;
		margin: -15px 0 0 -15px;
		border: 2px solid #f26b1d;
		border-radius: 50%;
		background: rgb(242 107 29 / 0.16);
		pointer-events: none;
	}
</style>

<script>
	interface Row {
		rest: string;
		html: string;
		scene?: string;
	}
	const root = document.querySelector<HTMLElement>('[data-dx]');
	const stage = root?.closest<HTMLElement>('section');
	if (root && stage && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const term = root.querySelector<HTMLElement>('[data-term]')!;
		const body = root.querySelector<HTMLElement>('[data-dx-body]')!;
		const browser = root.querySelector<HTMLElement>('[data-browser]')!;
		const lights = browser.querySelector<HTMLElement>('[data-lights]')!;
		const closeButton = browser.querySelector<HTMLElement>('[data-close]')!;
		const address = browser.querySelector<HTMLElement>('[data-url]')!;
		const lock = browser.querySelector<SVGElement>('[data-lock]')!;
		const rows = JSON.parse(root.querySelector('[data-dx-rows]')!.textContent!) as Row[];
		root.setAttribute('data-interactive', '');

		// Waits run only while the terminal is on screen.
		let visible = false;
		const waiting = new Set<() => void>();
		new IntersectionObserver(
			([entry]) => {
				visible = entry.isIntersecting && entry.intersectionRatio >= 0.25;
				if (visible) {
					for (const resume of waiting) resume();
					waiting.clear();
				}
			},
			{ threshold: [0, 0.3] },
		).observe(term);
		const sleep = (ms: number) => new Promise<void>((done) => setTimeout(() => (visible ? done() : waiting.add(done)), ms));

		// A job is something that can be called off: the demo loop, or one play
		// of the app. Once it is over, its next wait throws STOP, which unwinds it.
		const STOP = new Error('stopped');
		type Job = { live: boolean };
		const wait = async (job: Job, ms: number) => {
			await sleep(ms);
			if (!job.live) throw STOP;
		};
		const type = async (job: Job, el: HTMLElement, text: string, ms = 40, jitter = 36) => {
			for (const ch of text) {
				el.textContent += ch;
				await wait(job, ms + Math.random() * jitter);
			}
		};
		const span = (cls = '', text = '') => Object.assign(document.createElement('span'), { className: cls, textContent: text });
		const show = (el: HTMLElement) => {
			el.hidden = false;
			el.animate([{ opacity: 0, translate: '0 0.4em' }, { opacity: 1, translate: '0 0' }], { duration: 240, easing: 'ease-out' });
		};

		// The demo runs until the visitor clicks a URL or the close button.
		const demo: Job = { live: true };

		// The pointer lives in the section, in its coordinates, so it scrolls
		// with the page. Its position is the `translate` property and a click
		// scales the icon inside it around the hot spot, so a click never moves it.
		const cursor = document.createElement('div');
		cursor.className = 'dx-cursor';
		cursor.hidden = true;
		cursor.setAttribute('aria-hidden', 'true');
		cursor.innerHTML =
			'<div class="dx-cursor-icon">' +
			'<svg class="dx-arrow" viewBox="0 0 28 28"><polygon fill="#fff" points="8.2,20.9 8.2,4.9 19.8,16.5 13,16.5 12.6,16.6"/><polygon fill="#fff" points="17.3,21.6 13.7,23.1 9,12 12.7,10.5"/><rect x="12.5" y="13.6" transform="matrix(0.9221 -0.3871 0.3871 0.9221 -5.7605 6.5909)" width="2" height="8"/><polygon points="9.2,7.3 9.2,18.5 12.2,15.6 12.6,15.5 17.4,15.5"/></svg>' +
			'<svg class="dx-hand" viewBox="0 0 28 28"><g transform="translate(3.5 2.5) scale(0.88)" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path fill="#fff" d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15V4a2 2 0 0 1 4 0v5.5a2 2 0 0 1 3 0V10a2 2 0 0 1 4 0Z"/><path fill="none" d="M11 9.5V12M14 10v2M18 11v1.5"/></g></svg>' +
			'</div>';
		const icon = cursor.firstElementChild as HTMLElement;
		stage.append(cursor);
		let cur = { x: -60, y: 0 };
		let pinned: { el: Element; fx: number; fy: number } | null = null;
		let gliding = false;
		const at = (el: Element, fx: number, fy: number) => {
			const r = el.getBoundingClientRect(), s = stage.getBoundingClientRect();
			return { x: r.left - s.left + r.width * fx, y: r.top - s.top + r.height * fy };
		};
		const draw = () => cursor.style.setProperty('translate', `${cur.x}px ${cur.y}px`);
		const ease = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
		const glide = (to: () => { x: number; y: number }, ms: number) =>
			new Promise<void>((done) => {
				const from = { ...cur }, t0 = performance.now(), bend = (Math.random() - 0.5) * 0.5;
				const tick = (now: number) => {
					if (!demo.live) return done();
					const k = Math.min(1, (now - t0) / ms), e = ease(k), end = to();
					// A slight arc, like a hand moving a mouse.
					const c = { x: (from.x + end.x) / 2 - (end.y - from.y) * bend, y: (from.y + end.y) / 2 + (end.x - from.x) * bend };
					cur = { x: (1 - e) ** 2 * from.x + 2 * (1 - e) * e * c.x + e * e * end.x, y: (1 - e) ** 2 * from.y + 2 * (1 - e) * e * c.y + e * e * end.y };
					draw();
					if (k < 1) requestAnimationFrame(tick);
					else done();
				};
				requestAnimationFrame(tick);
			});
		const moveTo = async (el: Element, fx = 0.5, fy = 0.6, ms = 700) => {
			pinned = null;
			cursor.hidden = false;
			gliding = true;
			await glide(() => at(el, fx, fy), ms);
			gliding = false;
			if (!demo.live) throw STOP;
			pinned = { el, fx, fy };
		};
		// From the side of the page away from the terminal.
		const farSide = () => {
			const s = stage.getBoundingClientRect(), t = term.getBoundingClientRect();
			return t.left + t.width / 2 - s.left < s.width / 2 ? s.width + 50 : -50;
		};
		const enter = () => {
			const s = stage.getBoundingClientRect(), t = term.getBoundingClientRect();
			cur = { x: farSide(), y: t.top - s.top + t.height * (0.35 + Math.random() * 0.5) };
			draw();
		};
		const leave = async () => {
			pinned = null;
			const x = farSide(), y = cur.y + 140;
			await glide(() => ({ x, y }), 900);
			cursor.hidden = true;
		};
		const hand = (on: boolean) => cursor.toggleAttribute('data-hand', on);
		const ripple = () => {
			const ring = document.createElement('div');
			ring.className = 'dx-ripple';
			Object.assign(ring.style, { left: `${cur.x}px`, top: `${cur.y}px` });
			stage.append(ring);
			ring.animate([{ scale: '0.3', opacity: 0.9 }, { scale: '1', opacity: 0 }], { duration: 480, easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)' }).finished.then(() => ring.remove());
		};
		const click = async (times = 1) => {
			for (let i = 0; i < times; i++) {
				ripple();
				icon.animate([{ scale: '1' }, { scale: '0.82' }, { scale: '1' }], { duration: 150, easing: 'ease-out' });
				await wait(demo, times > 1 ? 120 : 170);
			}
		};

		// The browser window: over the terminal, pulled toward the middle of
		// the section, and wider and taller than the terminal so it pops out.
		const place = () => {
			const s = stage.getBoundingClientRect(), t = term.getBoundingClientRect();
			const narrow = s.width < 640, gutter = s.width < 1024 ? 12 : 24;
			const w = Math.round(Math.min(740, s.width - gutter * 2, narrow ? Infinity : t.width * 1.25));
			const h = Math.round(w * (w < 520 ? 1.18 : 0.62));
			const tx = t.left - s.left + t.width / 2, ty = t.top - s.top + t.height / 2;
			const cx = tx + (s.width / 2 - tx) * 0.4;
			const x = Math.max(gutter, Math.min(s.width - gutter - w, cx - w / 2));
			Object.assign(browser.style, { left: `${x}px`, top: `${Math.round(ty - h / 2)}px`, width: `${w}px`, height: `${h}px` });
		};
		new ResizeObserver(() => {
			if (browser.hasAttribute('data-open')) place();
			if (pinned && !gliding) {
				cur = at(pinned.el, pinned.fx, pinned.fy);
				draw();
			}
		}).observe(stage);

		// Each scene's moving parts. The markup is the finished run; `reset`
		// takes a scene back to its start and `play` runs it again.
		const scenes = new Map(
			[...browser.querySelectorAll<HTMLElement>('[data-scene]')].map((el) => {
				const q = (sel: string) => el.querySelector<HTMLElement>(sel)!;
				const answer = q('[data-answer]');
				const paragraphs = [...answer.children].map((p) => {
					const texts: [Text, string][] = [];
					const walk = document.createTreeWalker(p, NodeFilter.SHOW_TEXT);
					for (let n = walk.nextNode(); n; n = walk.nextNode()) texts.push([n as Text, (n as Text).data]);
					return { p: p as HTMLElement, texts };
				});
				const scene = {
					el,
					url: el.dataset.url!,
					secure: el.hasAttribute('data-secure'),
					empty: q('[data-empty]'),
					user: q('[data-user]'),
					bot: q('[data-bot]'),
					prompt: q('[data-prompt]').textContent!,
					thinking: q('[data-thinking]'),
					tools: q('[data-tools]'),
					steps: [...q('[data-tools]').children] as HTMLElement[],
					count: q('[data-count]'),
					paragraphs,
					input: q('[data-input]'),
					draft: q('[data-draft]'),
					send: q('[data-send]'),
				};
				return [el.dataset.scene!, scene] as const;
			}),
		);
		type Scene = NonNullable<ReturnType<typeof scenes.get>>;

		const reset = (s: Scene) => {
			s.el.removeAttribute('data-busy');
			s.empty.hidden = false;
			s.user.hidden = s.bot.hidden = true;
			s.thinking.hidden = false;
			s.tools.hidden = true;
			for (const step of s.steps) {
				step.hidden = true;
				step.removeAttribute('data-done');
			}
			s.count.textContent = '';
			for (const { p, texts } of s.paragraphs) {
				p.hidden = true;
				p.classList.remove('pp-cur');
				for (const [node] of texts) node.data = '';
			}
			s.draft.textContent = '';
			s.input.removeAttribute('data-focus');
			s.send.removeAttribute('data-ready');
		};

		// Richard types the prompt and sends it, and the agent gets to work.
		// `started` settles once its first tool call is running.
		const play = (job: Job, s: Scene) => {
			let started: () => void = () => {};
			const progress = new Promise<void>((done) => (started = () => done()));
			const run = async () => {
				await wait(job, 360);
				s.input.setAttribute('data-focus', '');
				await wait(job, 200);
				await type(job, s.draft, s.prompt, 10, 12);
				s.send.setAttribute('data-ready', '');
				await wait(job, 300);
				s.send.animate([{ scale: '1' }, { scale: '0.88' }, { scale: '1' }], { duration: 160, easing: 'ease-out' });
				s.draft.textContent = '';
				s.send.removeAttribute('data-ready');
				s.input.removeAttribute('data-focus');
				s.empty.hidden = true;
				show(s.user);
				s.el.setAttribute('data-busy', '');
				await wait(job, 300);
				show(s.bot);
				await wait(job, 500);
				s.thinking.hidden = true;
				s.tools.hidden = false;
				let tools = 0;
				for (const step of s.steps) {
					show(step);
					if (!step.hasAttribute('data-tool')) {
						await wait(job, 300);
						continue;
					}
					tools++;
					s.count.textContent = `${tools} tool${tools === 1 ? '' : 's'}`;
					started();
					await wait(job, 550 + Math.random() * 350);
					step.setAttribute('data-done', '');
				}
				await wait(job, 250);
				// The answer streams in a word at a time.
				for (const { p, texts } of s.paragraphs) {
					p.hidden = false;
					p.classList.add('pp-cur');
					for (const [node, text] of texts) {
						for (const word of text.match(/\S+\s*|\s+/g) ?? []) {
							node.data += word;
							await wait(job, 24 + Math.random() * 30);
						}
					}
					p.classList.remove('pp-cur');
				}
				s.el.removeAttribute('data-busy');
			};
			const done = run().catch((error) => {
				if (error !== STOP) console.error(error);
			});
			return { progress, done };
		};

		// macOS brings a new window in by fading it in as it scales up from 90%,
		// quickly and without overshoot. Here it scales from the clicked link,
		// and closing runs the same in reverse.
		const SMALL = { opacity: 0, transform: 'scale(0.9)' };
		let motion: Animation | null = null;
		let playing: Job = { live: false };
		let turn = 0;
		const openApp = (s: Scene, link: HTMLElement) => {
			turn++;
			playing.live = false;
			motion?.cancel();
			for (const other of scenes.values()) other.el.toggleAttribute('data-active', other === s);
			address.textContent = s.url;
			lock.style.display = s.secure ? '' : 'none';
			lights.removeAttribute('data-hover');
			reset(s);
			place();
			const b = browser.getBoundingClientRect(), l = link.getBoundingClientRect();
			const clamp = (v: number, max: number) => Math.round(Math.max(0, Math.min(max, v)));
			browser.style.transformOrigin = `${clamp(l.left + l.width / 2 - b.left, b.width)}px ${clamp(l.top + l.height / 2 - b.top, b.height)}px`;
			browser.setAttribute('data-open', '');
			term.setAttribute('data-inactive', '');
			motion = browser.animate([SMALL, { opacity: 1, offset: 0.6 }, { opacity: 1, transform: 'none' }], {
				duration: 280,
				easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
			});
			playing = { live: true };
			return play(playing, s);
		};
		const closeApp = async () => {
			if (!browser.hasAttribute('data-open')) return;
			const mine = ++turn;
			playing.live = false;
			// From wherever an opening got to, so a quick close never jumps.
			const now = getComputedStyle(browser);
			const from = { opacity: now.opacity, transform: now.transform };
			motion?.cancel();
			const shrink = (motion = browser.animate([from, SMALL], { duration: 180, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }));
			term.removeAttribute('data-inactive');
			await shrink.finished.catch(() => {});
			if (mine !== turn) return;
			browser.removeAttribute('data-open');
			lights.removeAttribute('data-hover');
			shrink.cancel();
			motion = null;
		};

		// The live session types over the finished one.
		const live = document.createElement('div');
		live.className = 'dx-live';
		live.setAttribute('aria-hidden', 'true');
		body.append(live);
		root.setAttribute('data-live', '');
		const caret = span('dx-caret');

		const command = async (row: Row, first: boolean) => {
			const block = document.createElement('div');
			block.className = 'dx-row';
			const line = document.createElement('p');
			const word = span(), rest = span();
			line.append(span('prompt', '$ '), word, rest, caret);
			block.append(line);
			live.append(block);
			caret.hidden = false;
			await wait(demo, first ? 500 : 350);
			await type(demo, word, 'wrangler');
			await type(demo, rest, row.rest);
			await wait(demo, 220);

			// The pointer double-clicks "wrangler", and "orange" is typed over it.
			const arriving = cursor.hidden;
			if (arriving) enter();
			await moveTo(word, 0.42, 0.72, arriving ? 1000 : 600);
			await click(2);
			word.classList.add('dx-sel');
			caret.hidden = true;
			line.insertBefore(caret, rest);
			await wait(demo, 420);
			word.className = 'text-orange';
			word.textContent = '';
			caret.hidden = false;
			await type(demo, word, 'orange', 60, 30);
			await wait(demo, 280);
			caret.remove();
			block.insertAdjacentHTML('beforeend', row.html);
			await wait(demo, 450);

			// Then it clicks the printed URL, watches the agent start, and closes
			// the window again.
			const link = block.querySelector<HTMLElement>('[data-link]');
			const scene = row.scene ? scenes.get(row.scene) : undefined;
			if (link && scene) {
				await moveTo(link, 0.3, 0.75, 600);
				hand(true);
				link.dataset.hover = '';
				await wait(demo, 220);
				await click();
				const { progress, done } = openApp(scene, link);
				await wait(demo, 120);
				hand(false);
				delete link.dataset.hover;
				await Promise.race([progress, done]);
				await wait(demo, 1000);
				await moveTo(closeButton, 0.5, 0.5, 600);
				lights.setAttribute('data-hover', '');
				await wait(demo, 240);
				await click();
				await closeApp();
				pinned = null;
			} else {
				await wait(demo, 500);
				await leave();
			}
		};

		// A click on a URL or the close button hands the window to the visitor:
		// the demo stops, the terminal shows the finished session, and every
		// open plays the scene from the start.
		const takeOver = () => {
			if (!demo.live) return;
			demo.live = false;
			cursor.remove();
			live.remove();
			root.removeAttribute('data-live');
			lights.removeAttribute('data-hover');
		};
		const ghostLinks = [...root.querySelectorAll<HTMLElement>('[data-ghost] [data-link]')];
		for (const link of ghostLinks) {
			link.tabIndex = 0;
			link.setAttribute('role', 'button');
		}
		const openFrom = (link: HTMLElement) => {
			takeOver();
			const id = link.dataset.link!;
			const scene = scenes.get(id);
			const ghost = ghostLinks.find((el) => el.dataset.link === id);
			if (scene && ghost) void openApp(scene, ghost);
		};
		root.addEventListener('click', (event) => {
			const target = event.target as Element;
			const link = target.closest<HTMLElement>('[data-link]');
			if (link) openFrom(link);
			else if (target.closest('[data-close]')) {
				takeOver();
				void closeApp();
			}
		});
		root.addEventListener('keydown', (event) => {
			const link = (event.target as Element).closest<HTMLElement>('[data-link]');
			if (link && (event.key === 'Enter' || event.key === ' ')) {
				event.preventDefault();
				openFrom(link);
			}
		});
		// Tabbing to a URL shows the finished session, so its focus ring shows.
		root.addEventListener('focusin', (event) => {
			if ((event.target as Element).closest('[data-ghost]')) takeOver();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && browser.hasAttribute('data-open')) {
				takeOver();
				void closeApp();
			}
		});

		const run = async () => {
			for (;;) {
				live.replaceChildren();
				for (const [i, row] of rows.entries()) await command(row, i === 0);
				await wait(demo, 3200);
			}
		};
		run().catch((error) => {
			if (error === STOP) return;
			// Fall back to the finished session.
			console.error(error);
			takeOver();
			motion?.cancel();
			browser.removeAttribute('data-open');
			term.removeAttribute('data-inactive');
		});
	}
</script>
