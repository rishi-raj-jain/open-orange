---
// Same commands, new name. The terminal types each Wrangler command; a mouse
// pointer barges in, double-clicks "wrangler" and it is retyped as "orange".
// Then the pointer clicks the printed URL and a browser window opens the app.
// Without JS or with reduced motion it shows the finished session.
import Argument from '@/components/Argument.astro';
import Tip from '@/components/Tip.astro';
import { DX_COMMANDS } from '@/data/site';

// Output lines as the orange CLI prints them (src/commands/dev.ts, deploy.ts).
const OUTPUT = [
	{ html: '<p><span class="text-cream/60">Ready on</span> <span class="dx-link" data-link>http://127.0.0.1:8787</span></p>', url: '127.0.0.1:8787' },
	{ html: '<p><span class="text-[#4ade80]">✓</span> Deployed pied-piper to staging</p><p class="text-cream/60">  URL     <span class="dx-link" data-link>https://staging.piedpiper.com</span></p>', url: 'staging.piedpiper.com' },
	{ html: '<p class="font-semibold">Dry run. Nothing was built or sent to Rivet Cloud.</p>' },
];
const rows = DX_COMMANDS.map((row, i) => ({ rest: row.orange.replace(/^orange/, ''), ...OUTPUT[i] }));
---

<Argument id="dx" split flip heading="Don't sacrifice your DX.">
	<Fragment slot="lede">
		Your <Tip tip="Bindings, environments, build commands and .dev.vars work as they do with Wrangler." align="start">wrangler.jsonc</Tip> stays the source of truth. Same commands, new name.
	</Fragment>
	<div class="plate relative" data-dx>
		<div class="plate-bar">
			<span class="flex gap-1.5" aria-hidden="true"><span class="h-2.5 w-2.5 rounded-full bg-white/15"></span><span class="h-2.5 w-2.5 rounded-full bg-white/15"></span><span class="h-2.5 w-2.5 rounded-full bg-white/15"></span></span>
			<span class="ml-2">~/pied-piper</span>
		</div>
		<div class="min-h-[17rem] whitespace-pre px-5 py-4" data-dx-body aria-label="orange dev, orange deploy -e staging, orange deploy --dry-run">
			{rows.map((row) => (
				<div class="pb-2">
					<p><span class="prompt">$ </span><span class="text-orange">orange</span>{row.rest}</p>
					<Fragment set:html={row.html} />
				</div>
			))}
		</div>

		<!-- The app, opened from the printed URL. -->
		<div class="dx-browser theme-light absolute inset-x-6 bottom-5 top-12 flex flex-col overflow-hidden rounded-xl bg-white font-sans text-ink shadow-2xl ring-1 ring-black/10" data-browser aria-hidden="true">
			<div class="flex items-center gap-3 border-b border-line bg-paper-mid px-3 py-2">
				<span class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]" data-close></span><span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span></span>
				<span class="flex-1 truncate rounded-md bg-white px-2.5 py-0.5 text-center text-[11px] text-ink-faint" data-url></span>
			</div>
			<div class="flex flex-1 flex-col justify-center gap-3 bg-[#f3faf5] px-6 py-4">
				<p class="flex items-center gap-2 text-[15px] font-semibold text-[#1f7a46]">
					<svg width="20" height="20" viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" fill="#1f7a46" /><path d="M6 13.5c2.5-1 4-3.5 4.5-7M10.5 6.5c1 2.5 2.4 4.4 4 5.2" stroke="#fff" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg>
					Pied Piper
				</p>
				<p class="text-[19px] font-semibold leading-tight tracking-[-0.02em]">Middle-out compression.</p>
				<div class="rounded-lg bg-white p-3 ring-1 ring-black/5">
					<div class="flex justify-between text-[11px] text-ink-faint"><span>season-finale.mov</span><span>Weissman score 5.2</span></div>
					<div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#1f7a46]/15"><div class="dx-progress h-full rounded-full bg-[#1f7a46]"></div></div>
				</div>
			</div>
		</div>

	</div>
	<script type="application/json" data-dx-rows set:html={JSON.stringify(rows)} />
</Argument>

<style is:global>
	@keyframes dx-caret {
		50% {
			opacity: 0;
		}
	}
	.dx-caret {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		margin-bottom: -0.2em;
		background: currentColor;
		animation: dx-caret 1s steps(1) infinite;
	}
	.dx-link {
		text-decoration: underline;
		text-decoration-color: rgb(245 245 244 / 0.35);
		text-underline-offset: 3px;
	}
	.dx-link[data-hover] {
		color: #fff;
		text-decoration-color: #fff;
	}
	/* The fake pointer lives on the page, not in the terminal, so it can come
	   in from anywhere. macOS arrow and pointing hand, with the system shadow. */
	.dx-cursor {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 60;
		width: 28px;
		height: 28px;
		pointer-events: none;
		filter: drop-shadow(0 1px 1.2px rgb(0 0 0 / 0.45));
		will-change: transform;
	}
	.dx-cursor svg {
		position: absolute;
		inset: 0;
	}
	.dx-cursor .hand,
	.dx-cursor[data-hand] .arrow {
		display: none;
	}
	.dx-cursor[data-hand] .hand {
		display: block;
	}
	.dx-sel {
		background: rgb(255 255 255 / 0.28);
	}
	.dx-browser {
		opacity: 0;
		transform: translateY(10px) scale(0.96);
		pointer-events: none;
		transition:
			opacity 0.25s,
			transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.15);
	}
	.dx-browser[data-open] {
		opacity: 1;
		transform: none;
	}
	.dx-progress {
		width: 8%;
	}
	.dx-browser[data-open] .dx-progress {
		width: 94%;
		transition: width 1.6s ease-out 0.3s;
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-dx]');
	if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const body = root.querySelector<HTMLElement>('[data-dx-body]')!;
		const browser = root.querySelector<HTMLElement>('[data-browser]')!;
		const rows = JSON.parse(document.querySelector('[data-dx-rows]')!.textContent!) as { rest: string; html: string; url?: string }[];

		let visible = false;
		let wake: (() => void) | null = null;
		new IntersectionObserver(([e]) => {
			visible = e.isIntersecting;
			if (visible && wake) { wake(); wake = null; }
		}).observe(root);
		// Waits `ms`, and longer while the terminal is off screen.
		const sleep = (ms: number) => new Promise<void>((done) => setTimeout(() => (visible ? done() : (wake = done)), ms));
		const span = (cls = '', text = '') => Object.assign(document.createElement('span'), { className: cls, textContent: text });
		const caret = span('dx-caret');
		caret.setAttribute('aria-hidden', 'true');
		const type = async (el: HTMLElement, text: string, ms = 55) => {
			for (const ch of text) { el.textContent += ch; await sleep(ms + Math.random() * 40); }
		};

		// The pointer: a fixed element on the page, positioned in viewport
		// coordinates. It glides along a curve, eases in and out, and stays
		// pinned to whatever it is over while the page scrolls.
		const cursor = document.createElement('div');
		cursor.className = 'dx-cursor';
		cursor.style.display = 'none';
		cursor.setAttribute('aria-hidden', 'true');
		cursor.innerHTML =
			'<svg class="arrow" viewBox="0 0 28 28"><polygon fill="#fff" points="8.2,20.9 8.2,4.9 19.8,16.5 13,16.5 12.6,16.6"/><polygon fill="#fff" points="17.3,21.6 13.7,23.1 9,12 12.7,10.5"/><rect x="12.5" y="13.6" transform="matrix(0.9221 -0.3871 0.3871 0.9221 -5.7605 6.5909)" width="2" height="8"/><polygon points="9.2,7.3 9.2,18.5 12.2,15.6 12.6,15.5 17.4,15.5"/></svg>' +
			'<svg class="hand" viewBox="0 0 28 28"><g transform="translate(3.5 2.5) scale(0.88)" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path fill="#fff" d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15V4a2 2 0 0 1 4 0v5.5a2 2 0 0 1 3 0V10a2 2 0 0 1 4 0Z"/><path fill="none" d="M11 9.5V12M14 10v2M18 11v1.5"/></g></svg>';
		document.body.append(cursor);
		// Hot spots: the arrow's tip, the hand's fingertip.
		const HOT = { arrow: { x: 8.5, y: 5 }, hand: { x: 9.6, y: 3.6 } };
		let cur = { x: -60, y: innerHeight * 0.6 };
		let pinned: { el: Element; fx: number; fy: number } | null = null;
		const at = (el: Element, fx: number, fy: number) => {
			const r = el.getBoundingClientRect();
			return { x: r.left + r.width * fx, y: r.top + r.height * fy };
		};
		const draw = () => {
			const hot = cursor.hasAttribute('data-hand') ? HOT.hand : HOT.arrow;
			cursor.style.transform = `translate(${cur.x - hot.x}px, ${cur.y - hot.y}px)`;
		};
		addEventListener('scroll', () => { if (pinned) { cur = at(pinned.el, pinned.fx, pinned.fy); draw(); } }, { passive: true });
		const ease = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
		const glide = (to: () => { x: number; y: number }, ms: number) =>
			new Promise<void>((done) => {
				const from = { ...cur }, t0 = performance.now(), bend = (Math.random() - 0.5) * 0.5;
				const tick = (now: number) => {
					const k = Math.min(1, (now - t0) / ms), e = ease(k), end = to();
					// A slight arc, like a hand moving a mouse.
					const c = { x: (from.x + end.x) / 2 - (end.y - from.y) * bend, y: (from.y + end.y) / 2 + (end.x - from.x) * bend };
					cur = { x: (1 - e) ** 2 * from.x + 2 * (1 - e) * e * c.x + e * e * end.x, y: (1 - e) ** 2 * from.y + 2 * (1 - e) * e * c.y + e * e * end.y };
					draw();
					if (k < 1) requestAnimationFrame(tick); else done();
				};
				requestAnimationFrame(tick);
			});
		const moveTo = async (el: Element, fx = 0.5, fy = 0.7, ms = 750) => {
			pinned = null;
			cursor.style.display = '';
			await glide(() => at(el, fx, fy), ms);
			pinned = { el, fx, fy };
		};
		// Come in from off the page: a far side of the viewport, away from the terminal.
		const enterFrom = () => {
			const r = root.getBoundingClientRect();
			const right = r.left + r.width / 2 < innerWidth / 2;
			cur = { x: right ? innerWidth + 40 : -40, y: Math.max(40, Math.min(innerHeight - 40, r.top + r.height * (0.2 + Math.random() * 0.9))) };
			draw();
		};
		const leave = async () => {
			pinned = null;
			const r = root.getBoundingClientRect();
			const right = r.left + r.width / 2 < innerWidth / 2;
			await glide(() => ({ x: right ? innerWidth + 60 : -60, y: Math.min(innerHeight + 60, cur.y + 160) }), 900);
			cursor.style.display = 'none';
		};
		const hand = (on: boolean) => { cursor.toggleAttribute('data-hand', on); draw(); };
		const click = async (times = 1) => {
			for (let i = 0; i < times; i++) {
				cursor.animate([{ scale: '1' }, { scale: '0.86' }, { scale: '1' }], { duration: 130 });
				await sleep(150);
			}
		};

		const run = async () => {
			for (;;) {
				body.replaceChildren();
				for (const row of rows) {
					const block = document.createElement('div');
					block.className = 'pb-2';
					const line = document.createElement('p');
					const word = span(), rest = span();
					line.append(span('prompt', '$ '), word, rest, caret);
					block.append(line);
					body.append(block);
					await sleep(350);
					await type(word, 'wrangler');
					await type(rest, row.rest);
					await sleep(200);

					// The pointer barges in from off the page and double-clicks "wrangler".
					enterFrom();
					await moveTo(word, 0.45, 0.75, 1300);
					await click(2);
					word.classList.add('dx-sel');
					line.insertBefore(caret, rest);
					caret.style.display = 'none';
					await sleep(450);
					word.classList.remove('dx-sel');
					word.textContent = '';
					word.className = 'text-orange';
					caret.style.display = '';
					await type(word, 'orange', 70);
					await sleep(250);
					caret.remove();

					block.insertAdjacentHTML('beforeend', row.html);
					await sleep(500);

					// Then it clicks the URL, and the app opens.
					const link = block.querySelector<HTMLElement>('[data-link]');
					if (link && row.url) {
						await moveTo(link, 0.35, 0.8, 650);
						hand(true);
						link.dataset.hover = '';
						await sleep(200);
						await click();
						root.querySelector('[data-url]')!.textContent = row.url;
						browser.toggleAttribute('data-open', true);
						hand(false);
						await sleep(400);
						await moveTo(browser.querySelector('[data-browser] .dx-progress')!, 0.6, 0.5, 600);
						await sleep(1700);
						await moveTo(root.querySelector('[data-close]')!, 0.5, 0.6, 600);
						hand(true);
						await click();
						hand(false);
						browser.removeAttribute('data-open');
						delete link.dataset.hover;
						await sleep(350);
					} else {
						await sleep(400);
					}
					await leave();
				}
				await sleep(3500);
			}
		};
		run();
	}
</script>
