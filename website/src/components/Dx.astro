<Argument id="dx" split flip heading="Don't sacrifice your DX.">
	<Fragment slot="lede">
		Your <Tip tip="Bindings, environments, build commands and .dev.vars work as they do with Wrangler." align="start">wrangler.jsonc</Tip> stays the source of truth. Same commands, new name.
	</Fragment>
	<div class="dx" data-dx>
		<div class="plate dx-win dx-term" data-term>
			<div class="dx-bar">
				<span class="dx-lights" aria-hidden="true"><i></i><i></i><i></i></span>
				<span class="dx-title">pied-piper — zsh</span>
			</div>
			<div class="dx-body" data-dx-body>
				<div data-ghost>
					{rows.map((row) => (
						<div class="dx-row">
							<p><span class="prompt">$ </span><span class="text-orange">orange</span>{row.rest}</p>
							<Fragment set:html={row.html} />
						</div>
					))}
				</div>
			</div>
		</div>

		<!-- The app, opened from the printed URL. Pied Piper's own palette and
		     layout, sized in em so the whole window scales with its width. -->
		<div class="dx-win dx-browser theme-light" data-browser aria-hidden="true">
			<div class="dx-bar">
				<span class="dx-lead">
					<span class="dx-lights" data-lights><i data-close></i><i></i><i></i></span>
					<span class="dx-nav">
						<svg viewBox="0 0 20 20"><rect width="15" height="12" x="2.5" y="4" rx="2.5" /><path d="M7.5 4v12" /></svg>
						<svg viewBox="0 0 20 20"><path d="M12 4.5 6.5 10l5.5 5.5" /></svg>
						<svg class="dx-off" viewBox="0 0 20 20"><path d="m8 4.5 5.5 5.5L8 15.5" /></svg>
					</span>
				</span>
				<span class="dx-addr">
					<svg class="dx-lock" data-lock viewBox="0 0 24 24"><rect width="16" height="11" x="4" y="11" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>
					<span data-url>staging.piedpiper.com</span>
				</span>
			</div>
			<div class="dx-page">
				{SCENES.map((scene) => (
					<div
						class="pp"
						data-scene={scene.id}
						data-url={scene.url}
						data-secure={scene.secure ? '' : undefined}
						data-active={scene.id === 'staging' ? '' : undefined}
					>
						<header class="pp-top">
							<svg class="pp-waves" viewBox="0 0 890 40" preserveAspectRatio="none">
								<path d="M0 26C90 14 170 34 280 24S470 8 590 20 790 34 890 18V40H0Z" fill="#03735a" opacity=".85" />
								<path d="M0 33C120 24 210 40 330 31S540 20 660 29 820 38 890 30V40H0Z" fill="#025f47" opacity=".95" />
								<path d="M0 12C110 4 200 20 320 12S520 0 640 9 800 18 890 6V0H0Z" fill="#0ba680" opacity=".6" />
							</svg>
							<svg class="pp-word" viewBox="3 1 121 33"><use href="#dx-pp-wordmark" /></svg>
							<span class="pp-crumb">/<b>{scene.agent}</b></span>
							<span class="pp-on"><Logo size={64} /><span>OpenOrange</span></span>
						</header>
						<div class="pp-main">
							<aside class="pp-side">
								<p class="pp-side-head"><span>Agents<span class="pp-n">{scene.agents.length}</span></span><span class="pp-new">New</span></p>
								{scene.agents.map((name) => (
									<p class:list={['pp-agent', { sel: name === scene.agent }]}>
										<span class="pp-agent-av"><i>{name[0]}</i></span>
										<span class="pp-meta">
											<span class="pp-name">{name}</span>
											<span class="pp-sub"><span class="pp-idle">Idle</span><span class="pp-busy">Working…</span></span>
										</span>
										{name === scene.agent && <span class="pp-dot" />}
									</p>
								))}
								<p class="pp-host">Served by <b>{scene.host}</b></p>
							</aside>
							<section class="pp-chat">
								<div class="pp-msgs">
									<div class="pp-flow">
										<div class="pp-empty" data-empty hidden>
											<span class="pp-bot-av pp-big"><i>{scene.agent[0]}</i></span>
											<p class="pp-empty-name">{scene.agent}</p>
											<p>Ask for code. The agent works in its own VM, and everyone in this thread sees it live.</p>
										</div>
										<div class="pp-msg" data-user>
											<span class="pp-av" style={`--s:2;background:${colorFor(ME)}`}><i>{ME[0]}</i></span>
											<div>
												<p class="pp-who"><b>{ME}</b></p>
												<p class="pp-bubble" data-prompt>{scene.prompt}</p>
											</div>
										</div>
										<div class="pp-msg" data-bot>
											<span class="pp-bot-av"><i>{scene.agent[0]}</i></span>
											<div class="min-w-0">
												<p class="pp-who">
													<b>{scene.agent}</b>
													<span class="pp-tag">Agent</span>
													<span data-count>{scene.tools.length} tools</span>
													<span class="pp-live">working</span>
												</p>
												<p class="pp-thinking" data-thinking hidden>Thinking…</p>
												<div class="pp-tools" data-tools>
													{scene.tools.map((tool) => (
														<Fragment>
															<p class="pp-tool" data-tool data-done>
																<span class="pp-t">{tool.name}</span>
																<span class="pp-a">{tool.arg}</span>
																<span class="pp-s" />
