	/* The terminal: a dark window, so a dark title bar. */
	.dx .dx-term {
		position: relative;
		box-shadow:
			0 0 0 0.5px rgb(0 0 0 / 0.55),
			0 4px 12px rgb(0 0 0 / 0.1),
