---
// The architecture diagram on /docs/architecture/, framed like a docs figure.
// The diagram is HTML and theme tokens (ArchitectureDiagram.astro), so it
// follows light and dark without an SVG pair; `not-prose` keeps the docs
// typography off it.
import ArchitectureDiagram from '@/components/ArchitectureDiagram.astro';
---

<figure class="not-prose card my-8 p-4 leading-normal sm:p-6" aria-labelledby="architecture-caption">
	<ArchitectureDiagram />
	<figcaption id="architecture-caption" class="sr-only">Your Docker containers, in any cloud, connect out to the Rivet control plane, which is backed by S3 with an SSD layer in front.</figcaption>
</figure>
