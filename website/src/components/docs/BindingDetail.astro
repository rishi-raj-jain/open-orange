---
// One binding's compatibility details, all from the conformance data in
// packages/cloudflare-conformance: status, what it runs on, the product note,
// how it scales, and the recorded results and feature-matrix rows behind it.
// Configuration, behaviour and deviations are the doc page's own content above.
import Chip from '@/components/compat/Chip.astro';
import ClaimRow from '@/components/compat/ClaimRow.astro';
import MatrixRow from '@/components/compat/MatrixRow.astro';
import RowHead from '@/components/compat/RowHead.astro';
import ProviderList from '@/components/ProviderList.astro';
import { PROVIDERS } from '@/data/site';
import type { Binding } from '@/data/bindings';
import { CONFORMANCE, PRODUCT_LABEL, inline } from '@/data/conformance';

interface Props {
	b: Binding;
	first?: boolean;
}
const { b, first = true } = Astro.props;
const s = PRODUCT_LABEL[b.product.status];
---

<section class:list={['binding-detail scroll-mt-20', !first && 'rule mt-14 pt-10']} id={b.slug}>
	<div>
		<div>
			<div>
				<h3 class="text-[1.375rem] font-medium leading-tight tracking-[-0.02em]">{b.product.product}</h3>
				<div class="mt-4 flex flex-wrap items-center gap-2">
					<Chip tone={s.tone} label={s.label} />
					{b.doc.wranglerKeys.map((k) => (
						<code class="code-chip">{k}</code>
					))}
				</div>
			</div>
			<div class="mt-5">
				<p class="text-[14.5px] text-ink-soft">Runs on <span class="font-medium text-ink" set:html={inline(b.product.orange)} />.</p>
				<p class="mt-3 text-[16px] leading-[1.6] text-ink-soft" set:html={inline(b.product.note)} />
				{PROVIDERS[b.slug] ? (
					<div class="mt-5">
						<p class="label">Works with</p>
						<div class="mt-2.5"><ProviderList slug={b.slug} note /></div>
					</div>
				) : null}
				{b.scaling ? (
					<p class="mt-4 text-[14.5px] text-ink-soft">
						Scales by <span class="font-medium text-ink">{b.scaling.scalesBy}</span>. <span set:html={inline(b.scaling.detail)} />
					</p>
				) : null}
			</div>
		</div>

		{b.claims.length ? (
			<div class="mt-12">
				<p class="label">Recorded results</p>
				<div class="mt-4">
					<RowHead name="Claim" a="On Cloudflare" b="On OpenOrange" end="Results" />
					<div class="rows">
						{b.claims.map((c) => (
							<ClaimRow claim={c} />
						))}
					</div>
				</div>
			</div>
		) : null}

		{b.matrix.length ? (
			<div class="mt-12">
				<p class="label">In the feature matrix</p>
				<div class="mt-4">
					<RowHead name="Feature" a="On Cloudflare" b="On OpenOrange" end="Evidence" />
					<div class="rows">
						{b.matrix.map((e) => (
							<MatrixRow entry={e} matrixHref={`/docs/compatibility/#${e.id}`} />
						))}
					</div>
				</div>
			</div>
		) : null}

	</div>
</section>

<style>
	/* The docs column is too narrow for the six-column row grid: put the
	   Cloudflare and OpenOrange text on their own labelled lines under the name. */
	@media (min-width: 768px) {
		.binding-detail :global(.row-cols) {
			grid-template-columns: 1.25rem 6.5rem minmax(0, 1fr) auto;
			align-items: start;
			row-gap: 0.375rem;
		}
		.binding-detail :global(.row-cols > :nth-child(3)) {
			grid-column: 3;
			grid-row: 1;
		}
		.binding-detail :global(.row-cols > :nth-child(6)) {
			grid-column: 4;
			grid-row: 1;
		}
		.binding-detail :global(.row-cols > :nth-child(4)),
		.binding-detail :global(.row-cols > :nth-child(5)) {
			grid-column: 3 / 5;
		}
		.binding-detail :global(.row-cols:not(.row-head) > :nth-child(4):not(:empty))::before {
			content: 'Cloudflare: ';
			font-size: 13.5px;
			font-weight: 500;
		}
		.binding-detail :global(.row-cols:not(.row-head) > :nth-child(5):not(:empty))::before {
			content: 'OpenOrange: ';
			font-size: 13.5px;
			font-weight: 500;
			color: var(--color-ink);
		}
		.binding-detail :global(.row-head > :nth-child(4)),
		.binding-detail :global(.row-head > :nth-child(5)) {
			display: none;
		}
	}
</style>
