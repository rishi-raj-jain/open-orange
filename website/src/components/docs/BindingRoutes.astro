---
// The short binding → service map on /docs/architecture/, from BINDING_ROUTES
// (src/data/architecture.ts), each target led by the brand icons of the
// services it names (src/data/service-icons.ts). `id="services"` keeps the old
// /architecture/#services links landing on it.
import { BINDING_ROUTES, NOT_SUPPORTED } from '@/data/architecture';
import { SERVICE_ICONS } from '@/data/service-icons';
---

<div id="services" class="not-prose my-8 scroll-mt-24 leading-normal">
	<ul class="card divide-y divide-line">
		{BINDING_ROUTES.map((route) => (
			<li class="grid gap-x-5 gap-y-2 px-4 py-4 sm:px-5 md:grid-cols-[minmax(0,0.9fr)_1rem_minmax(0,1.3fr)] md:items-start">
				<ul class="flex flex-wrap gap-1.5">
					{route.bindings.map((b) => (
						<li>
							<a href={b.href} class="inline-flex items-center rounded-md border border-line bg-paper-mid px-2 py-0.5 text-[13px] font-medium text-ink no-underline transition-colors hover:border-ink-faint motion-reduce:transition-none">{b.label}</a>
						</li>
					))}
				</ul>
				<span class="hidden pt-1 text-ink-faint md:block" aria-hidden="true">→</span>
				<div class="flex items-start gap-3">
					<span class="pt-1 text-ink-faint md:hidden" aria-hidden="true">→</span>
					<!-- A fixed slot, two icons wide, so every service name lines up. -->
					<ul class="flex w-[3.75rem] shrink-0 flex-wrap gap-1" aria-hidden="true">
						{route.icons.map((id) => (
							<li title={SERVICE_ICONS[id].name} class="grid size-7 place-items-center rounded-lg border border-line bg-surface text-ink" style={SERVICE_ICONS[id].color ? `color: ${SERVICE_ICONS[id].color}` : undefined}>
								<span class="block size-4 [&>svg]:size-full" set:html={SERVICE_ICONS[id].svg} />
							</li>
						))}
					</ul>
					<div class="min-w-0 pt-1">
						<p class="text-[15px] font-semibold leading-snug text-ink">{route.service}</p>
						<p class="mt-1 text-[13.5px] leading-snug text-ink-soft">{route.detail}</p>
					</div>
				</div>
			</li>
		))}
	</ul>
	{NOT_SUPPORTED.length ? (
		<p class="caption mt-4">Not supported yet: {NOT_SUPPORTED.join(', ')}. These bindings load, and each call throws.</p>
	) : null}
</div>
