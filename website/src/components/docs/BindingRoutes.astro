---
// The short binding → service map on /docs/architecture/, from BINDING_ROUTES
// (src/data/architecture.ts). `id="services"` keeps the old
// /architecture/#services links landing on it.
import { BINDING_ROUTES, NOT_SUPPORTED } from '@/data/architecture';
---

<div id="services" class="not-prose my-8 scroll-mt-24 leading-normal">
	<ul class="card divide-y divide-line">
		{BINDING_ROUTES.map((route) => (
			<li class="grid gap-x-6 gap-y-2 px-4 py-4 sm:px-5 md:grid-cols-[minmax(0,1fr)_1.25rem_minmax(0,1.1fr)] md:items-start">
				<ul class="flex flex-wrap gap-1.5">
					{route.bindings.map((b) => (
						<li>
							<a href={b.href} class="inline-flex items-center rounded-md border border-line bg-paper-mid px-2 py-0.5 text-[13px] font-medium text-ink no-underline transition-colors hover:border-ink-faint motion-reduce:transition-none">{b.label}</a>
						</li>
					))}
				</ul>
				<span class="hidden pt-0.5 text-ink-faint md:block" aria-hidden="true">→</span>
				<div>
					<p class="flex items-center gap-2 text-[15px] font-semibold leading-snug text-ink">
						<span class="text-ink-faint md:hidden" aria-hidden="true">→</span>
						{route.rivet ? <span class="size-2.5 shrink-0 rounded-[2px] bg-orange" aria-hidden="true" /> : null}
						{route.service}
					</p>
					<p class="mt-1 text-[13.5px] leading-snug text-ink-soft">{route.detail}</p>
				</div>
			</li>
		))}
	</ul>
	{NOT_SUPPORTED.length ? (
		<p class="caption mt-4">Not supported yet: {NOT_SUPPORTED.join(', ')}. These bindings load, and each call throws.</p>
	) : null}
</div>
