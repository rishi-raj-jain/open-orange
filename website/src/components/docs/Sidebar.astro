---
// The docs sidebar: one labelled section per top-level group, and each
// sub-group (Compute, Storage, …) as a fold that starts open when it holds the
// current page.
import type { DocGroup, DocLink } from './nav';

interface Props {
	groups: DocGroup[];
	current: string;
}

const { groups, current } = Astro.props;
const holds = (group: DocGroup) => group.links.some((link) => link.href === current);

// Lucide icons (24px grid) for the top-level items, by route or fold title.
const ICONS: Record<string, string> = {
	'/docs/': '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
	'/docs/architecture/': '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
	'/docs/deploy/': '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
	'/docs/migrate/': '<path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/>',
	'/docs/bindings/': '<path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/>',
	'/docs/bindings/configuration/': '<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>',
	'/docs/errors/': '<circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
	Compute: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
	Storage: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
	AI: '<path d="M9.94 14.06 4 20M14.5 3.5 16 8l4.5 1.5L16 11l-1.5 4.5L13 11 8.5 9.5 13 8z"/>',
	'Runtime APIs': '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
};
const linkClass =
	'flex items-center gap-2.5 rounded-lg border border-transparent px-3 py-1.5 text-[14px] leading-snug text-ink-soft transition-colors hover:bg-paper-mid hover:text-ink motion-reduce:transition-none aria-[current=page]:border-orange/45 aria-[current=page]:bg-orange-soft aria-[current=page]:font-medium aria-[current=page]:text-orange-deep';
---

<nav aria-label="Documentation" class="flex flex-col gap-7">
	{groups.map((group) => (
		<div>
			<p class="label px-3 pb-2">{group.title}</p>
			<ul class="flex flex-col gap-px">
				{group.links.map((link: DocLink) => (
					<li>
						<a href={link.href} aria-current={link.href === current ? 'page' : undefined} class={linkClass}>
							{ICONS[link.href] && <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[link.href]} />}
							{link.label}
						</a>
					</li>
				))}
				{group.groups?.map((sub) => (
					<li>
						<details class="fold" open={holds(sub)}>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-lg border border-transparent px-3 py-1.5 text-[14px] leading-snug text-ink-soft transition-colors hover:bg-paper-mid hover:text-ink motion-reduce:transition-none">
								<span class="flex items-center gap-2.5">
									{ICONS[sub.title] && <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[sub.title]} />}
									{sub.title}
								</span>
								<span class="flex items-center gap-1.5 text-ink-faint">
									<span class="text-[12px] tabular-nums">{sub.links.length}</span>
									<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" class="chev transition-transform motion-reduce:transition-none" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
								</span>
							</summary>
							<ul class="ml-[19px] mt-px flex flex-col gap-px border-l border-line pl-2">
								{sub.links.map((link) => (
									<li><a href={link.href} aria-current={link.href === current ? 'page' : undefined} class={linkClass}>{link.label}</a></li>
								))}
							</ul>
						</details>
					</li>
				))}
			</ul>
		</div>
	))}
</nav>

<style>
	.fold > summary::-webkit-details-marker {
		display: none;
	}
	.icon {
		flex: none;
		color: var(--color-ink-faint);
	}
	a[aria-current='page'] .icon {
		color: currentColor;
	}
	.fold[open] > summary .chev {
		transform: rotate(90deg);
	}
</style>
