---
// The status summary (TL;DR) at the top of every binding page. Its status,
// backend, Wrangler keys, scaling, and check counts come from the conformance
// data (packages/cloudflare-conformance), so they never drift from the status
// and compatibility pages. Whether data can move from Cloudflare comes from
// src/data/binding-migration.ts. The page writes only three one-line summaries:
//
//   <BindingStatus
//     binding="kv"
//     works="`get()`, `put()`, `list()`, metadata, and expiration"
//     differs="Writes are visible at once everywhere"
//     missing="Nothing"
//   />
//
// `binding` is a slug from src/data/binding-docs.ts. Backticks become code.
// The check count links to #test-evidence, the <BindingEvidence> in the
// page's <AiContext>.
import { MIGRATION, MIGRATION_LABEL } from '@/data/binding-migration';
import { BINDINGS } from '@/data/bindings';
import { PRODUCT_LABEL, TONE_CLASS, inline, type ClaimStatus } from '@/data/conformance';

interface Props {
	binding: string;
	/** What runs as on Cloudflare, in one line. */
	works: string;
	/** What behaves differently, in one line. */
	differs?: string;
	/** What is not there, in one line. */
	missing?: string;
}

const { binding, works, differs, missing } = Astro.props;
const b = BINDINGS.find((x) => x.slug === binding);
if (!b) throw new Error(`<BindingStatus binding="${binding}">: no such binding in src/data/binding-docs.ts`);

const status = PRODUCT_LABEL[b.product.status];
const migration = MIGRATION[binding]!;
const migrationLabel = MIGRATION_LABEL[migration.kind];
const migrationTone = TONE_CLASS[migrationLabel.tone];
const tone = TONE_CLASS[status.tone];
const order: ClaimStatus[] = ['works', 'partial', 'does-not-work', 'not-run'];
const checkWord: Record<ClaimStatus, string> = { works: 'pass', partial: 'partial', 'does-not-work': 'fail', 'not-run': 'not run' };
const checks = order
	.map((s) => ({ s, n: b.claims.filter((c) => c.status === s).length }))
	.filter((c) => c.n > 0);
const rows = [
	{ label: 'Works', text: works, dot: 'dot-pass' },
	{ label: 'Differs', text: differs, dot: 'dot-warn' },
	{ label: 'Missing', text: missing, dot: 'dot-fail' },
].filter((r) => r.text);
---

<section class="binding-status card" aria-label="Status summary">
	<div class="bs-head">
		<span class={`chip gap-1.5 ${tone.chip}`}><span class={`${tone.dot} size-1.5`}></span>{status.label}</span>
		<p class="bs-runs">Runs on <strong set:html={inline(b.product.orange)} /></p>
	</div>
	<dl class="bs-rows">
		{rows.map((r) => (
			<div class="bs-row">
				<dt><span class={`${r.dot} size-2`} aria-hidden="true"></span>{r.label}</dt>
				<dd set:html={inline(r.text!)} />
			</div>
		))}
		<div class="bs-row">
			<dt>
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink-faint" aria-hidden="true"><path d="M2.5 8h10M9 4.5L12.5 8 9 11.5" /></svg>Migration
			</dt>
			<dd>
				<span class={`chip mr-1.5 ${migrationTone.chip}`} title={migrationLabel.meaning}>{migrationLabel.label}</span>
				<span set:html={inline(migration.detail)} />
				{migration.href && <> <a class="bs-link" href={migration.href}>Migration guide</a></>}
			</dd>
		</div>
	</dl>
	<dl class="bs-facts">
		{b.doc.wranglerKeys.length > 0 && (
			<div>
				<dt>Configure</dt>
				<dd>{b.doc.wranglerKeys.map((k) => <code>{k}</code>)}</dd>
			</div>
		)}
		{b.scaling && (
			<div>
				<dt>Scales by</dt>
				<dd>{b.scaling.scalesBy}</dd>
			</div>
		)}
		{checks.length > 0 && (
			<div>
				<dt>Checks</dt>
				<dd>
					<a href="#test-evidence">{checks.map((c) => `${c.n} ${checkWord[c.s]}`).join(' · ')}</a>
				</dd>
			</div>
		)}
	</dl>
</section>

<style>
	.binding-status {
		margin: 0 0 2.5rem;
		padding: 1.125rem 1.25rem 1rem;
		font-size: 15px;
		line-height: 1.55;
	}
	.bs-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.375rem 0.75rem;
	}
	.bs-head .chip {
		position: relative;
		top: -1px;
	}
	.bs-runs {
		margin: 0;
		color: var(--color-ink-soft);
	}
	.bs-runs strong {
		font-weight: 500;
		color: var(--color-ink);
	}
	.bs-rows {
		margin: 0.875rem 0 0;
		border-top: 1px solid var(--color-line);
		padding-top: 0.75rem;
	}
	.bs-row {
		display: grid;
		gap: 0.125rem 1rem;
		padding: 0.3125rem 0;
	}
	@media (min-width: 640px) {
		.bs-row {
			grid-template-columns: 5.5rem minmax(0, 1fr);
		}
	}
	.bs-row dt {
		align-self: start;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-ink);
		font-size: 13.5px;
		font-weight: 600;
		line-height: 1.6rem;
	}
	.bs-row dd {
		margin: 0;
		color: var(--color-ink-soft);
	}
	.bs-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 1.5rem;
		margin: 0.75rem 0 0;
		border-top: 1px solid var(--color-line);
		padding-top: 0.75rem;
		font-size: 13.5px;
	}
	.bs-facts > div {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.375rem;
	}
	.bs-facts dt {
		color: var(--color-ink-faint);
	}
	.bs-facts dd {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin: 0;
		color: var(--color-ink);
	}
	.binding-status :global(code) {
		border: 1px solid var(--color-line);
		border-radius: 0.375rem;
		background: var(--color-paper-mid);
		padding: 0.0625rem 0.3125rem;
		font-family: var(--font-mono);
		font-size: 0.84em;
		color: var(--color-ink);
	}
	.bs-facts a,
	.bs-link {
		color: var(--color-ink);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
		text-underline-offset: 3px;
	}
	.bs-facts a:hover,
	.bs-link:hover {
		text-decoration-color: var(--color-orange);
	}
</style>
