---
// "In case of emergency, break glass" box.
//
// Three images of the same 760x1013 photograph:
//   break-glass.webp       the box, glass intact (shown until it breaks)
//   break-glass-open.webp  the same box with the glass gone
//   break-glass-pane.webp  only the glass: the printed text and the reflection,
//                          as white with alpha, so open + pane = intact
// break-glass.webp is made by drawing the pane over the open box (alpha "over",
// then lossy WebP at quality 92), so the orange is the same pixels before and
// after the break. Remake it whenever either of the other two changes.
//
// Clicking breaks the pane where it was hit. Cracks run out from the impact as a
// spider web, the web's cells come loose and fall as 3D shards (with the printed
// text on them, lit as they tumble, with green glass edges), some bounce off the
// bottom of the frame, and jagged pieces stay stuck in the frame. Falling shards
// are drawn on a viewport canvas so they can fall out of the box; the pieces that
// stay are drawn on a canvas inside the box at the end.
import { SITE } from '@/data/site';

interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`break-glass relative mx-auto w-full max-w-[360px] select-none ${className}`} data-break-glass>
	<button
		type="button"
		class="box relative block w-full rounded-xl text-left focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-orange/50"
		aria-label="Break the glass and start migrating"
		data-glass
		data-href={SITE.docsMigrate}
	>
		<span class="tilt relative block" data-tilt>
			<!-- Shadow under the frame, so the box sits off the page. -->
			<span class="frame-shadow pointer-events-none absolute" aria-hidden="true"></span>
			<img src="/images/break-glass-open.webp" alt="" width="760" height="1013" class="block h-auto w-full" draggable="false" />
			<!-- The orange, cut out so it can react when it is freed. -->
			<span class="fruit pointer-events-none absolute inset-0" aria-hidden="true" data-fruit></span>
			<canvas class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true" data-rest></canvas>
			<img src="/images/break-glass.webp" alt="" width="760" height="1013" class="intact absolute inset-0 block h-auto w-full" draggable="false" />
			<span class="pane pointer-events-none absolute overflow-hidden" aria-hidden="true">
				<span class="sheen absolute inset-0"></span>
			</span>
		</span>

		<!-- After: the box is the link. -->
		<span class="after pointer-events-none absolute left-[6%] top-[11%] flex h-[72%] w-[72%] items-end justify-center pb-[18%]" aria-hidden="true">
			<span class="btn-light theme-light">Start migrating →</span>
		</span>
	</button>
</div>

<style>
	.break-glass {
		perspective: 900px;
	}
	/* The frame's footprint in the photo (x 30–632, y 55–903 of 760×1013).
	   A contact shadow, a mid shadow and a wide soft one, offset down and to
	   the right as if lit from the top left. */
	.frame-shadow {
		left: 4.2%;
		right: 17%;
		top: 5.8%;
		bottom: 11.2%;
		border-radius: 5% / 3.6%;
		box-shadow:
			0 1px 2px rgb(26 25 24 / 0.35),
			0 6px 10px -2px rgb(26 25 24 / 0.28),
			6px 22px 32px -6px rgb(26 25 24 / 0.32),
			14px 48px 70px -18px rgb(26 25 24 / 0.3);
	}
	.tilt {
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1);
		transform-style: preserve-3d;
	}
	.break-glass:not([data-broken]) .box:active .tilt {
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(0.985);
		transition-duration: 0.08s;
	}
	[data-broken] .intact,
	[data-broken] .pane {
		visibility: hidden;
	}

	.fruit {
		background: url(/images/break-glass-open.webp) 0 0 / 100% 100%;
		/* The orange: centre (330, 495), radius 119 in the photo. */
		clip-path: circle(13.3% at 43.4% 48.9%);
		transform-origin: 43.4% 60%;
	}

	/* The glass pane in the photo: x 100-560, y 132-827. */
	.pane {
		left: 13.16%;
		top: 13.03%;
		width: 60.53%;
		height: 68.61%;
	}
	.sheen {
		background: radial-gradient(60% 45% at var(--sx, 30%) var(--sy, 20%), rgb(255 255 255 / 0.13), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s;
	}
	.break-glass:hover .sheen {
		opacity: 1;
	}

	.after {
		opacity: 0;
		transform: translateY(10px) scale(0.96);
		transition:
			opacity 0.35s ease 0.9s,
			transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.35) 0.9s;
	}
	[data-broken] .after {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.tilt,
		.after {
			transition: none;
		}
	}
</style>

<script>
	const W = 760;
	const H = 1013;
	const PANE = { x0: 100, y0: 132, x1: 560, y1: 827 };
	const LEDGE = PANE.y1 + 4; // the bottom of the frame, where falling shards hit
	const G = 3000; // gravity, photo px / s²
	const FOCAL = 1100; // perspective for shards coming towards the viewer
	const THICK = 5; // glass thickness, photo px

	type V2 = [number, number];
	type V3 = [number, number, number];
	type Shard = {
		poly: V2[]; // in the photo, as cut
		tri: [number, number, number]; // three far-apart corners, for texture mapping
		c: V2; // centroid in the photo
		pos: V3; // centroid now (z towards the viewer)
		vel: V3;
		rot: V3; // angles about x, y, z
		spin: V3;
		detachAt: number; // seconds after impact; Infinity stays in the frame
		crackAt: number; // when the crack front reaches its far corner
		state: 'fixed' | 'flying' | 'gone';
		bounced: boolean;
	};

	const rand = (a: number, b: number) => a + Math.random() * (b - a);
	const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
	const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function loadImage(src: string) {
		const img = new Image();
		img.src = src;
		img.decode().catch(() => {});
		return img;
	}

	// Sutherland–Hodgman clip of a polygon to the pane rectangle.
	function clipToPane(poly: V2[]): V2[] {
		const edges: [(p: V2) => boolean, (a: V2, b: V2) => V2][] = [
			[(p) => p[0] >= PANE.x0, (a, b) => [PANE.x0, a[1] + ((b[1] - a[1]) * (PANE.x0 - a[0])) / (b[0] - a[0])]],
			[(p) => p[0] <= PANE.x1, (a, b) => [PANE.x1, a[1] + ((b[1] - a[1]) * (PANE.x1 - a[0])) / (b[0] - a[0])]],
			[(p) => p[1] >= PANE.y0, (a, b) => [a[0] + ((b[0] - a[0]) * (PANE.y0 - a[1])) / (b[1] - a[1]), PANE.y0]],
			[(p) => p[1] <= PANE.y1, (a, b) => [a[0] + ((b[0] - a[0]) * (PANE.y1 - a[1])) / (b[1] - a[1]), PANE.y1]],
		];
		let out = poly;
		for (const [inside, cut] of edges) {
			const input = out;
			out = [];
			for (let i = 0; i < input.length; i++) {
				const a = input[i];
				const b = input[(i + 1) % input.length];
				if (inside(b)) {
					if (!inside(a)) out.push(cut(a, b));
					out.push(b);
				} else if (inside(a)) {
					out.push(cut(a, b));
				}
			}
			if (!out.length) break;
		}
		return out;
	}

	// Real cracks wander. Each crack between two corners gets two jittered points,
	// derived from the corners alone so the pieces on both sides of it still fit.
	const onFrame = ([x, y]: V2) => x <= PANE.x0 + 0.5 || x >= PANE.x1 - 0.5 || y <= PANE.y0 + 0.5 || y >= PANE.y1 - 0.5;
	function jagged(poly: V2[]): V2[] {
		const out: V2[] = [];
		for (let i = 0; i < poly.length; i++) {
			const a = poly[i];
			const b = poly[(i + 1) % poly.length];
			out.push(a);
			if (onFrame(a) && onFrame(b) && (Math.abs(a[0] - b[0]) < 1 || Math.abs(a[1] - b[1]) < 1)) continue;
			const key = (p: V2) => Math.round(p[0] * 10) * 100003 + Math.round(p[1] * 10);
			const flip = key(a) > key(b);
			const [p, q] = flip ? [b, a] : [a, b];
			const len = Math.hypot(q[0] - p[0], q[1] - p[1]);
			if (len < 18) continue;
			let h = (key(p) * 31 + key(q)) % 2147483647;
			const next = () => ((h = (h * 48271) % 2147483647) / 2147483647) * 2 - 1;
			const nx = -(q[1] - p[1]) / len;
			const ny = (q[0] - p[0]) / len;
			const mids = [1 / 3, 2 / 3].map((f) => { const o = next() * len * 0.07; return [p[0] + (q[0] - p[0]) * f + nx * o, p[1] + (q[1] - p[1]) * f + ny * o] as V2; });
			out.push(...(flip ? mids.reverse() : mids));
		}
		return out;
	}
	function bigTriangle(poly: V2[]): [number, number, number] {
		let best: [number, number, number] = [0, 1, 2];
		let most = -1;
		for (let i = 0; i < poly.length; i++) for (let j = i + 1; j < poly.length; j++) for (let k = j + 1; k < poly.length; k++) {
			const a2 = Math.abs((poly[j][0] - poly[i][0]) * (poly[k][1] - poly[i][1]) - (poly[k][0] - poly[i][0]) * (poly[j][1] - poly[i][1]));
			if (a2 > most) { most = a2; best = [i, j, k]; }
		}
		return best;
	}

	const area = (poly: V2[]) => Math.abs(poly.reduce((s, p, i) => { const q = poly[(i + 1) % poly.length]; return s + p[0] * q[1] - q[0] * p[1]; }, 0)) / 2;
	const touchesFrame = (poly: V2[]) => poly.some(([x, y]) => x <= PANE.x0 + 0.5 || x >= PANE.x1 - 0.5 || y <= PANE.y0 + 0.5 || y >= PANE.y1 - 0.5);

	// A spider-web fracture: radial cracks from the impact, joined by jagged rings.
	function fracture(ix: number, iy: number): Shard[] {
		const rays = 15;
		const angles = Array.from({ length: rays }, (_, i) => ((i + rand(-0.32, 0.32)) / rays) * Math.PI * 2).sort((a, b) => a - b);
		const radii = [14, 34, 62, 100, 150, 215, 300, 410, 560, 800];
		const pts = angles.map((a) => radii.map((r, k) => {
			const rr = k === 0 ? r : r * rand(0.82, 1.18);
			const aa = a + (k ? rand(-0.06, 0.06) : 0);
			return [ix + Math.cos(aa) * rr, iy + Math.sin(aa) * rr] as V2;
		}));
		const shards: Shard[] = [];
		const add = (cell: V2[], dist: number) => {
			const clipped = clipToPane(cell);
			if (clipped.length < 3 || area(clipped) < 6) return;
			const c: V2 = [clipped.reduce((s, p) => s + p[0], 0) / clipped.length, clipped.reduce((s, p) => s + p[1], 0) / clipped.length];
			const far = Math.max(...clipped.map(([x, y]) => Math.hypot(x - ix, y - iy)));
			const stuck = touchesFrame(clipped) && dist > 120 && Math.random() < 0.5;
			const lateFall = stuck && Math.random() < 0.5;
			const poly = jagged(clipped);
			shards.push({
				poly,
				tri: bigTriangle(poly),
				c,
				pos: [c[0], c[1], 0],
				vel: [0, 0, 0],
				rot: [0, 0, 0],
				spin: [0, 0, 0],
				detachAt: stuck ? (lateFall ? rand(0.55, 1.4) : Infinity) : 0.075 + dist / 3800 + rand(0, 0.05) + (dist > 250 ? rand(0, 0.18) : 0),
				crackAt: far / 4200,
				state: 'fixed',
				bounced: false,
			});
		};
		for (let i = 0; i < rays; i++) {
			const j = (i + 1) % rays;
			// The innermost ring: little triangles of crushed glass.
			add([[ix, iy], pts[i][0], pts[j][0]], 0);
			for (let k = 0; k < radii.length - 1; k++) {
				const quad: V2[] = [pts[i][k], pts[i][k + 1], pts[j][k + 1], pts[j][k]];
				const dist = radii[k];
				// Split some cells along a diagonal, the way real glass breaks.
				if (k > 1 && Math.random() < 0.45) {
					add([quad[0], quad[1], quad[2]], dist);
					add([quad[0], quad[2], quad[3]], dist);
				} else {
					add(quad, dist);
				}
			}
		}
		return shards;
	}

	function launch(s: Shard, ix: number, iy: number) {
		const dx = s.c[0] - ix;
		const dy = s.c[1] - iy;
		const d = Math.max(1, Math.hypot(dx, dy));
		const kick = 950 * Math.exp(-d / 110);
		s.vel = [
			(dx / d) * kick * rand(0.6, 1.2) + rand(-25, 25),
			(dy / d) * kick * 0.8 - rand(0, 160) * Math.exp(-d / 160) + rand(-10, 30),
			620 * Math.exp(-d / 140) + rand(30, 140),
		];
		const tumble = 2 + 10 * Math.exp(-d / 180);
		s.spin = [rand(-1, 1) * tumble, rand(-1, 1) * tumble, rand(-1, 1) * (1 + tumble * 0.4)];
		s.state = 'flying';
	}

	// Rotate a point about the origin by the shard's angles (z, then x, then y).
	function rotate([x, y, z]: V3, [ax, ay, az]: V3): V3 {
		let cz = Math.cos(az), sz = Math.sin(az);
		[x, y] = [x * cz - y * sz, x * sz + y * cz];
		const cx = Math.cos(ax), sx = Math.sin(ax);
		[y, z] = [y * cx - z * sx, y * sx + z * cx];
		const cy = Math.cos(ay), sy = Math.sin(ay);
		[x, z] = [x * cy + z * sy, -x * sy + z * cy];
		return [x, y, z];
	}

	// Photo-space 3D point to photo-space 2D, with perspective towards the viewer
	// from the middle of the box.
	function project([x, y, z]: V3): V2 {
		const k = FOCAL / Math.max(80, FOCAL - z);
		return [W / 2 + (x - W / 2) * k, H / 2 + (y - H / 2) * k];
	}

	// The light comes from the top left; this is the half vector towards the viewer.
	const HALF: V3 = (() => {
		const l: V3 = [-0.45, -0.6, 0.66];
		const h: V3 = [l[0], l[1], l[2] + 1];
		const n = Math.hypot(...h);
		return [h[0] / n, h[1] / n, h[2] / n];
	})();

	function drawShard(ctx: CanvasRenderingContext2D, s: Shard, pane: HTMLImageElement, t: number) {
		const local = s.poly.map(([x, y]) => [x - s.c[0], y - s.c[1], 0] as V3);
		const front = local.map((p) => { const r = rotate(p, s.rot); return project([r[0] + s.pos[0], r[1] + s.pos[1], r[2] + s.pos[2]]); });
		const n = rotate([0, 0, 1], s.rot);
		const facing = Math.abs(n[2]);
		const fresnel = 1 - facing;
		const spec = Math.pow(Math.max(0, n[0] * HALF[0] + n[1] * HALF[1] + n[2] * HALF[2]), 28);
		const moving = s.state !== 'fixed';

		// Glass thickness: the back face and the sides, in that green glass-edge colour.
		if (moving && fresnel > 0.05) {
			const back = local.map((p) => { const r = rotate([p[0], p[1], -THICK], s.rot); return project([r[0] + s.pos[0], r[1] + s.pos[1], r[2] + s.pos[2]]); });
			ctx.fillStyle = `rgb(160 205 195 / ${0.12 + fresnel * 0.3})`;
			for (let i = 0; i < front.length; i++) {
				const j = (i + 1) % front.length;
				ctx.beginPath();
				ctx.moveTo(...front[i]);
				ctx.lineTo(...front[j]);
				ctx.lineTo(...back[j]);
				ctx.lineTo(...back[i]);
				ctx.closePath();
				ctx.fill();
			}
		}

		ctx.save();
		ctx.beginPath();
		front.forEach((p, i) => (i ? ctx.lineTo(...p) : ctx.moveTo(...p)));
		ctx.closePath();
		ctx.clip();
		// A faint body tint that grows towards grazing angles.
		ctx.fillStyle = `rgb(205 225 235 / ${moving ? 0.06 + fresnel * 0.4 : 0.03})`;
		ctx.fill();
		// The printed text and the reflection, mapped onto the shard (affine from three corners).
		const [i0, i1, i2] = s.tri;
		const [a, b, c] = [s.poly[i0], s.poly[i1], s.poly[i2]];
		const [A, B, C] = [front[i0], front[i1], front[i2]];
		const det = (b[0] - a[0]) * (c[1] - a[1]) - (c[0] - a[0]) * (b[1] - a[1]);
		if (Math.abs(det) > 1e-3) {
			const m11 = ((B[0] - A[0]) * (c[1] - a[1]) - (C[0] - A[0]) * (b[1] - a[1])) / det;
			const m12 = ((B[1] - A[1]) * (c[1] - a[1]) - (C[1] - A[1]) * (b[1] - a[1])) / det;
			const m21 = ((C[0] - A[0]) * (b[0] - a[0]) - (B[0] - A[0]) * (c[0] - a[0])) / det;
			const m22 = ((C[1] - A[1]) * (b[0] - a[0]) - (B[1] - A[1]) * (c[0] - a[0])) / det;
			const dx = A[0] - m11 * a[0] - m21 * a[1];
			const dy = A[1] - m12 * a[0] - m22 * a[1];
			ctx.save();
			ctx.transform(m11, m12, m21, m22, dx, dy);
			const xs = s.poly.map((p) => p[0]);
			const ys = s.poly.map((p) => p[1]);
			const sx = Math.max(0, Math.floor(Math.min(...xs)) - 1);
			const sy = Math.max(0, Math.floor(Math.min(...ys)) - 1);
			const sw = Math.min(W, Math.ceil(Math.max(...xs)) + 1) - sx;
			const sh = Math.min(H, Math.ceil(Math.max(...ys)) + 1) - sy;
			if (sw > 0 && sh > 0) ctx.drawImage(pane, sx, sy, sw, sh, sx, sy, sw, sh);
			ctx.restore();
		}
		// Specular glint as the face turns to the light.
		if (moving && spec > 0.02) {
			// A soft band of light that slides across the face as the shard tumbles.
			const xs = front.map((p) => p[0]);
			const ys = front.map((p) => p[1]);
			const x0 = Math.min(...xs), y0 = Math.min(...ys), x1 = Math.max(...xs), y1 = Math.max(...ys);
			const peak = clamp(0.5 + 0.45 * Math.sin(s.rot[0] * 1.3 + s.rot[1]), 0.08, 0.92);
			const band = ctx.createLinearGradient(x0, y0, x1, y1);
			band.addColorStop(0, 'rgb(255 255 255 / 0)');
			band.addColorStop(Math.max(0, peak - 0.18), 'rgb(255 255 255 / 0)');
			band.addColorStop(peak, `rgb(255 255 255 / ${Math.min(0.55, spec * 0.7)})`);
			band.addColorStop(Math.min(1, peak + 0.18), 'rgb(255 255 255 / 0)');
			band.addColorStop(1, 'rgb(255 255 255 / 0)');
			ctx.fillStyle = band;
			ctx.fill();
		}
		ctx.restore();

		// Edges: a dark line for contrast on light backgrounds and a bright one on top.
		// While the pane is still whole, they appear as the crack front passes.
		const edge = moving ? 1 : clamp((t - s.crackAt) / 0.05, 0, 1);
		if (edge > 0) {
			ctx.beginPath();
			front.forEach((p, i) => (i ? ctx.lineTo(...p) : ctx.moveTo(...p)));
			ctx.closePath();
			ctx.lineJoin = 'round';
			ctx.strokeStyle = `rgb(20 30 35 / ${0.35 * edge})`;
			ctx.lineWidth = 2.6;
			ctx.stroke();
			ctx.strokeStyle = `rgb(255 255 255 / ${(0.55 + fresnel * 0.4) * edge})`;
			ctx.lineWidth = 1.1;
			ctx.stroke();
		}
	}

	function sizeCanvas(canvas: HTMLCanvasElement, w: number, h: number) {
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		canvas.width = Math.round(w * dpr);
		canvas.height = Math.round(h * dpr);
		return dpr;
	}

	type Mote = { x: number; y: number; vx: number; vy: number; life: number; size: number };

	function shatter(root: HTMLElement, button: HTMLButtonElement, ix: number, iy: number, pane: HTMLImageElement) {
		const rest = root.querySelector<HTMLCanvasElement>('[data-rest]')!;
		const fruit = root.querySelector<HTMLElement>('[data-fruit]')!;
		const shards = fracture(ix, iy);
		root.dataset.broken = '';

		const paintRest = (t: number) => {
			const r = rest.getBoundingClientRect();
			const dpr = sizeCanvas(rest, r.width, r.height);
			const ctx = rest.getContext('2d')!;
			ctx.setTransform((r.width / W) * dpr, 0, 0, (r.height / H) * dpr, 0, 0);
			for (const s of shards) if (s.state === 'fixed') drawShard(ctx, s, pane, t);
		};

		if (reduceMotion()) {
			for (const s of shards) if (s.detachAt !== Infinity) s.state = 'gone';
			paintRest(10);
			return;
		}

		// Falling shards are drawn on a canvas over the whole viewport, so they can
		// leave the box without changing the page's size.
		const fly = document.createElement('canvas');
		Object.assign(fly.style, { position: 'fixed', inset: '0', width: '100vw', height: '100vh', pointerEvents: 'none', zIndex: '60' });
		document.body.append(fly);
		const ctx = fly.getContext('2d')!;
		const motes: Mote[] = Array.from({ length: 70 }, () => {
			const a = rand(0, Math.PI * 2);
			const v = rand(200, 1300);
			return { x: ix, y: iy, vx: Math.cos(a) * v, vy: Math.sin(a) * v - 200, life: rand(0.3, 0.8), size: rand(1, 2.6) };
		});

		// The box takes the hit: a hard punch, then a decaying shake.
		button.animate(
			[
				{ transform: 'none' },
				{ transform: 'translate(-6px, 5px) rotate(-1deg) scale(0.985)', offset: 0.08 },
				{ transform: 'translate(7px, -3px) rotate(0.8deg) scale(1.012)', offset: 0.2 },
				{ transform: 'translate(-4px, 2px) rotate(-0.45deg)', offset: 0.36 },
				{ transform: 'translate(2px, -1px) rotate(0.2deg)', offset: 0.55 },
				{ transform: 'translate(-1px, 0)', offset: 0.75 },
				{ transform: 'none' },
			],
			{ duration: 620, easing: 'ease-out' },
		);
		// The orange, freed, gives a little hop once the glass in front of it is gone.
		fruit.animate(
			[
				{ transform: 'none' },
				{ transform: 'none', offset: 0.35 },
				{ transform: 'translateY(-3.5%) scale(1.04, 0.97)', offset: 0.55 },
				{ transform: 'translateY(0) scale(0.97, 1.03)', offset: 0.75 },
				{ transform: 'none' },
			],
			{ duration: 900, easing: 'ease-out' },
		);

		const start = performance.now();
		let last = start;
		const frame = (now: number) => {
			// The first frame's timestamp can be a little before the click.
			const t = Math.max(0, (now - start) / 1000);
			const dt = clamp((now - last) / 1000, 0, 0.033);
			last = now;

			const box = button.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			if (fly.width !== Math.round(innerWidth * dpr) || fly.height !== Math.round(innerHeight * dpr)) sizeCanvas(fly, innerWidth, innerHeight);
			const k = box.width / W;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, innerWidth, innerHeight);
			ctx.setTransform(k * dpr, 0, 0, k * dpr, box.left * dpr, box.top * dpr);

			let busy = t < 1.6;
			for (const s of shards) {
				if (s.state === 'fixed' && t >= s.detachAt) launch(s, ix, iy);
				if (s.state === 'flying') {
					busy = true;
					s.vel[1] += G * dt;
					s.vel[0] *= 0.995;
					for (let i = 0; i < 3; i++) {
						s.pos[i] += s.vel[i] * dt;
						s.rot[i] += s.spin[i] * dt;
					}
					// Shards close to the glass plane hit the bottom of the frame once,
					// kick up and tip forward off it.
					if (!s.bounced && s.pos[2] < 40 && s.pos[1] > LEDGE - 6 && s.c[0] > PANE.x0 && s.c[0] < PANE.x1 && s.vel[1] > 0) {
						s.bounced = true;
						s.pos[1] = LEDGE - 6;
						s.vel[1] *= -0.28;
						s.vel[0] *= 0.6;
						s.vel[2] += rand(140, 260);
						s.spin = [s.spin[0] * 0.5 + rand(4, 8), s.spin[1] * 0.5, s.spin[2] * 0.5];
					}
					if (s.pos[1] > H + 900) s.state = 'gone';
				}
				if (s.state !== 'gone') drawShard(ctx, s, pane, t);
			}

			// Glass dust and the impact flash.
			ctx.globalCompositeOperation = 'lighter';
			for (const m of motes) {
				if (t > m.life) continue;
				m.vy += G * 0.6 * dt;
				m.x += m.vx * dt;
				m.y += m.vy * dt;
				m.vx *= 0.96;
				ctx.fillStyle = `rgb(255 255 255 / ${0.9 * (1 - t / m.life)})`;
				ctx.fillRect(m.x, m.y, m.size, m.size);
			}
			if (t < 0.22) {
				const f = t / 0.22;
				const r = 30 + 260 * Math.pow(f, 0.5);
				const g = ctx.createRadialGradient(ix, iy, 0, ix, iy, r);
				g.addColorStop(0, `rgb(255 255 255 / ${0.95 * (1 - f)})`);
				g.addColorStop(0.25, `rgb(255 250 235 / ${0.45 * (1 - f)})`);
				g.addColorStop(1, 'rgb(255 255 255 / 0)');
				ctx.fillStyle = g;
				ctx.fillRect(ix - r, iy - r, r * 2, r * 2);
			}
			ctx.globalCompositeOperation = 'source-over';

			if (busy) {
				requestAnimationFrame(frame);
			} else {
				paintRest(t);
				fly.remove();
			}
		};
		requestAnimationFrame(frame);
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-break-glass]')) {
		const button = root.querySelector<HTMLButtonElement>('[data-glass]')!;
		const tilt = root.querySelector<HTMLElement>('[data-tilt]')!;
		const pane = loadImage('/images/break-glass-pane.webp');
		loadImage('/images/break-glass-open.webp');

		// Hover: the box tilts towards the pointer and the light follows it.
		root.addEventListener('pointermove', (e) => {
			if (reduceMotion() || 'broken' in root.dataset) return;
			const r = tilt.getBoundingClientRect();
			const px = (e.clientX - r.left) / r.width;
			const py = (e.clientY - r.top) / r.height;
			tilt.style.setProperty('--ry', `${(px - 0.5) * 7}deg`);
			tilt.style.setProperty('--rx', `${(0.5 - py) * 6}deg`);
			tilt.style.setProperty('--sx', `${clamp(((px * W - PANE.x0) / (PANE.x1 - PANE.x0)) * 100, -20, 120)}%`);
			tilt.style.setProperty('--sy', `${clamp(((py * H - PANE.y0) / (PANE.y1 - PANE.y0)) * 100, -20, 120)}%`);
		});
		root.addEventListener('pointerleave', () => {
			tilt.style.removeProperty('--rx');
			tilt.style.removeProperty('--ry');
		});

		button.addEventListener('click', (e) => {
			if ('broken' in root.dataset) {
				window.open(button.dataset.href!, '_blank', 'noopener');
				return;
			}
			// Break where it was hit; from the keyboard, a little above the middle.
			const r = tilt.getBoundingClientRect();
			let ix = 300;
			let iy = 380;
			if (e.detail > 0) {
				ix = clamp(((e.clientX - r.left) / r.width) * W, PANE.x0 + 30, PANE.x1 - 30);
				iy = clamp(((e.clientY - r.top) / r.height) * H, PANE.y0 + 30, PANE.y1 - 30);
			}
			tilt.style.removeProperty('--rx');
			tilt.style.removeProperty('--ry');
			shatter(root, button, ix, iy, pane);
			button.setAttribute('aria-label', 'Glass broken. Start migrating');
		});
	}
</script>

<script>
	// The hammer hangs from the box's right edge on a chain and sways. When the
	// mouse comes near it drifts over; once close, the mouse holds it cocked
	// and twitching like it wants to hit something, with the chain sagging
	// from its handle. A click swings it so the head lands where you clicked,
	// which is also the click that breaks the glass. Leaving the hero lets go.
	// Verlet points with stick constraints, one fixed step per frame.
	for (const root of document.querySelectorAll<HTMLElement>('[data-break-glass]')) {
		const section = (root.closest('section') ?? root.parentElement) as HTMLElement;
		const box = root.querySelector<HTMLElement>('[data-tilt]')!;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const canvas = document.createElement('canvas');
		canvas.setAttribute('aria-hidden', 'true');
		canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:20';
		if (getComputedStyle(section).position === 'static') section.style.position = 'relative';
		section.append(canvas);
		const ctx = canvas.getContext('2d')!;
		const img = new Image();
		img.src = '/images/hammer.png';

		type P = { x: number; y: number; px: number; py: number; w: number };
		const LINKS = 12;
		let SEG = 13, HD = 180, HW = (HD * 209) / 560, HL = HD * 0.86;
		const pts: P[] = [];
		let anchor = { x: 0, y: 0 };
		let mouse: { x: number; y: number; vx: number } | null = null;
		let held = false, strikeAt = -1, t = 0, visible = false, raf = 0;

		// The chain hangs from the frame's right edge (x 632 of 760), a third down.
		const anchorNow = () => {
			const s = section.getBoundingClientRect(), b = box.getBoundingClientRect();
			return { x: b.left - s.left + b.width * (630 / 760), y: b.top - s.top + b.height * 0.3 };
		};
		const layout = () => {
			const dpr = devicePixelRatio || 1;
			canvas.width = section.clientWidth * dpr;
			canvas.height = section.clientHeight * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const bh = box.getBoundingClientRect().height;
			HD = Math.max(110, bh * 0.4); HW = (HD * 209) / 560; HL = HD * 0.86; SEG = Math.max(9, bh * 0.026);
			const next = anchorNow();
			if (!pts.length) {
				for (let i = 0; i <= LINKS; i++) pts.push({ x: next.x, y: next.y + i * SEG, px: next.x - i * 0.8, py: next.y + i * SEG, w: i ? 1 : 0 });
				pts.push({ x: next.x, y: next.y + LINKS * SEG + HL, px: next.x - 14, py: next.y + LINKS * SEG + HL, w: 0.35 });
			} else {
				const dx = next.x - anchor.x, dy = next.y - anchor.y;
				for (const p of pts) { p.x += dx; p.px += dx; p.y += dy; p.py += dy; }
			}
			anchor = next;
		};

		const E = () => pts[LINKS], H = () => pts[LINKS + 1];
		const stick = (a: P, b: P, len: number, wa = a.w, wb = b.w) => {
			const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 1;
			const k = (d - len) / d / (wa + wb || 1);
			a.x += dx * k * wa; a.y += dy * k * wa;
			b.x -= dx * k * wb; b.y -= dy * k * wb;
		};

		const step = () => {
			t += 1 / 60;
			anchor = anchorNow();
			if (mouse) mouse.vx *= 0.85;
			const e = E(), h = H(), dt2 = 1 / 3600;
			const grip = { x: e.x + (h.x - e.x) * 0.3, y: e.y + (h.y - e.y) * 0.3 };
			if (mouse && !held && Math.hypot(mouse.x - grip.x, mouse.y - grip.y) < 30) held = true;
			for (let i = 1; i < pts.length; i++) {
				const p = pts[i];
				let ax = 0, ay = 1500;
				if (p === h) ax += Math.sin(t * 0.9) * 70; // a draft keeps it swaying
				if (mouse && !held && (p === h || p === e)) {
					const dx = mouse.x - grip.x, dy = mouse.y - grip.y, d = Math.hypot(dx, dy) || 1;
					if (d < 220) { const f = (1 - d / 220) * 5600; ax += (dx / d) * f; ay += (dy / d) * f; }
				}
				const vx = (p.x - p.px) * 0.992, vy = (p.y - p.py) * 0.992;
				p.px = p.x; p.py = p.y;
				p.x += vx + ax * dt2; p.y += vy + ay * dt2;
			}
			if (held && mouse) {
				// Grip sits below and right of the pointer, so a swing lands the head
				// on it. Cocked back between swings, twitching.
				const reach = HL * 0.7;
				let g = { x: mouse.x + reach * 0.94, y: mouse.y + reach * 0.34 };
				const aim = Math.atan2(mouse.y - g.y, mouse.x - g.x);
				const since = strikeAt < 0 ? 9 : t - strikeAt;
				const swing = since < 0.08 ? since / 0.08 : since < 0.16 ? 1 : since < 0.42 ? 1 - (since - 0.16) / 0.26 : 0;
				const cocked = aim + 1.15 + Math.sin(t * 2.4) * 0.14 + Math.sin(t * 6.3) * 0.05 + Math.max(-0.4, Math.min(0.4, mouse.vx * 0.012));
				const a = cocked + (aim - cocked) * swing;
				const dir = { x: Math.cos(a), y: Math.sin(a) };
				// Keep the handle end within the chain's reach.
				const maxR = LINKS * SEG * 0.97;
				let end = { x: g.x - dir.x * HL * 0.3, y: g.y - dir.y * HL * 0.3 };
				const ra = Math.hypot(end.x - anchor.x, end.y - anchor.y);
				if (ra > maxR) {
					const k = maxR / ra;
					end = { x: anchor.x + (end.x - anchor.x) * k, y: anchor.y + (end.y - anchor.y) * k };
					g = { x: end.x + dir.x * HL * 0.3, y: end.y + dir.y * HL * 0.3 };
				}
				const th = { x: g.x + dir.x * HL * 0.7, y: g.y + dir.y * HL * 0.7 };
				const k = swing > 0 ? 0.8 : 0.35;
				e.x += (end.x - e.x) * k; e.y += (end.y - e.y) * k;
				h.x += (th.x - h.x) * k; h.y += (th.y - h.y) * k;
			}
			for (let n = 0; n < 12; n++) {
				for (let i = 0; i < LINKS; i++) stick(pts[i], pts[i + 1], SEG, pts[i].w, held && i + 1 === LINKS ? 0 : pts[i + 1].w);
				if (!held) stick(e, h, HL);
				pts[0].x = anchor.x; pts[0].y = anchor.y;
			}
		};

		const draw = () => {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			// Chain: links alternate face-on rings and edge-on bars.
			ctx.save();
			ctx.shadowColor = 'rgba(26,25,24,0.22)'; ctx.shadowBlur = 4; ctx.shadowOffsetX = 2; ctx.shadowOffsetY = 4;
			for (let i = 0; i < LINKS; i++) {
				const a = pts[i], b = pts[i + 1];
				ctx.save();
				ctx.translate((a.x + b.x) / 2, (a.y + b.y) / 2);
				ctx.rotate(Math.atan2(b.y - a.y, b.x - a.x));
				const grad = ctx.createLinearGradient(0, -4, 0, 4);
				grad.addColorStop(0, '#e2e5e8'); grad.addColorStop(0.5, '#8b9198'); grad.addColorStop(1, '#565c63');
				ctx.strokeStyle = grad; ctx.lineWidth = Math.max(2, SEG * 0.2);
				ctx.beginPath();
				ctx.ellipse(0, 0, SEG * 0.7, i % 2 ? SEG * 0.1 : SEG * 0.32, 0, 0, Math.PI * 2);
				ctx.stroke();
				ctx.restore();
			}
			ctx.restore();
			// Hammer: handle end on the chain, head toward the head point.
			const e = E(), h = H();
			if (img.complete && img.naturalWidth) {
				ctx.save();
				ctx.shadowColor = 'rgba(26,25,24,0.3)'; ctx.shadowBlur = 16; ctx.shadowOffsetX = 6; ctx.shadowOffsetY = 12;
				ctx.translate(e.x, e.y);
				ctx.rotate(Math.atan2(h.x - e.x, -(h.y - e.y)));
				ctx.drawImage(img, -HW / 2, -HD + 3, HW, HD);
				ctx.restore();
			}
		};

		const frame = () => {
			step();
			draw();
			raf = visible ? requestAnimationFrame(frame) : 0;
		};
		const start = () => { if (!raf && !reduced) raf = requestAnimationFrame(frame); };

		layout();
		if (reduced) { for (let i = 0; i < 400; i++) step(); img.onload = draw; draw(); }
		new ResizeObserver(() => { layout(); if (reduced) draw(); }).observe(section);
		new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (visible) start(); }).observe(section);

		addEventListener('pointermove', (ev) => {
			if (ev.pointerType !== 'mouse') return;
			const r = section.getBoundingClientRect();
			const x = ev.clientX - r.left, y = ev.clientY - r.top;
			if (x < 0 || y < 0 || x > r.width || y > r.height) { mouse = null; held = false; return; }
			mouse = { x, y, vx: mouse ? x - mouse.x : 0 };
		});
		section.addEventListener('pointerleave', () => { mouse = null; held = false; });
		section.addEventListener('pointerdown', (ev) => { if (held && ev.pointerType === 'mouse') strikeAt = t; });
	}
</script>
