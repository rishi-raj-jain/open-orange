---
// Cloudflare's meters next to raw AWS prices for the same unit, printed as a
// receipt. Four lines show; the rest print out on demand. Each line's details
// are on hover. The numbers and how they are converted live in COST in
// src/data/site.ts.
import Argument from '@/components/Argument.astro';
import Tip from '@/components/Tip.astro';
import Line from '@/components/ReceiptLine.astro';
import { CHEAPER_COMPUTE, CHEAPER_DATABASE, COST, COST_EXTRAS, SITE, WRITE_ESTIMATE } from '@/data/site';

const w = WRITE_ESTIMATE;
const writesNote = `Measured on Rivet: ${w.agents.toLocaleString('en-US')} concurrent agents, each writing a 64-byte SQLite upsert every 10 s, made ${(w.writesPerMonth / 1e9).toFixed(2)} billion writes a month for $${w.requestCostPerMonth} in S3 requests. Your cost per write depends on your workload.`;

const LABELS: Record<string, string> = {
	'durable-objects': 'DO compute',
	workers: 'Workers CPU',
	'do-sqlite-storage': 'DO SQLite',
	'd1-storage': 'D1',
	'kv-storage': 'KV',
	'workflows-storage': 'Workflows',
	'sqlite-writes': 'SQLite writes',
	'kv-writes': 'KV writes',
	queues: 'Queue msgs',
	'workflow-steps': 'Workflow steps',
};
const UNITS: Record<string, string> = { 'GB-hour': 'GB-h', 'vCPU-hour': 'vCPU-h', 'GB-month': 'GB-mo' };
const SHOWN = new Set(['durable-objects', 'workers', 'do-sqlite-storage', 'sqlite-writes']);
const lines = COST.groups.flatMap((g) =>
	g.meters.map((m) => ({
		...m,
		label: LABELS[m.id],
		unit: UNITS[m.unit] ?? m.unit.replace('million ', '1M '),
		tip: `${m.title}, per ${m.unit}. Cloudflare: ${m.cloudflareNote}. OpenOrange: ${m.openorangeNote}. ${(m.cloudflare / m.openorange).toFixed(1)}× cheaper.${g.title === 'Writes' ? ` ${writesNote}` : ''}`,
	})),
);
const shown = lines.filter((l) => SHOWN.has(l.id));
const more = lines.filter((l) => !SHOWN.has(l.id));
const [egress, credits] = COST_EXTRAS;
const writes = lines.find((l) => l.id === 'sqlite-writes')!;
const stats = [
	{ value: `${CHEAPER_COMPUTE.toFixed(1)}×`, label: 'cheaper compute' },
	{ value: `${CHEAPER_DATABASE.toFixed(1)}×`, label: 'cheaper storage' },
	{ value: `${(writes.cloudflare / writes.openorange).toFixed(1)}×`, label: 'cheaper writes' },
];
---

<Argument
	id="cost"
	split
	flip
	heading="Same work. A fraction of the bill."
	lede="Cloudflare's meters, priced on raw AWS."
	link={{ label: 'Cloudflare pricing', href: COST.source.durableObjects }}
>
	<dl slot="aside" class="mt-8 grid grid-cols-3 gap-4">
		{stats.map((s) => (
			<div class="flex flex-col-reverse">
				<dt class="caption mt-1.5">{s.label}</dt>
				<dd class="text-[1.75rem] font-medium leading-none tracking-[-0.03em] text-orange-deep md:text-[2rem]">{s.value}</dd>
			</div>
		))}
	</dl>

	<div class="receipt-wrap relative mx-auto h-[19.5rem] max-w-[460px]" data-receipt-wrap>
		<!-- Tilted about its top edge, so unrolling never moves what is already printed. -->
		<div class="receipt theme-light absolute inset-x-2 top-3 z-20 origin-top -rotate-1" data-receipt>
			<div class="paper relative bg-[#fffdf8] px-4 pb-6 pt-7 font-mono text-[12px] uppercase leading-relaxed text-ink sm:px-6 sm:text-[12.5px]" data-paper>
				<div class="text-center">
					<p class="text-[15px] font-semibold tracking-[0.2em]">OpenOrange</p>
					<p class="text-ink-faint">Same work. Less bill.</p>
					<p class="mt-1 text-[11px] text-ink-faint">
						<Tip tip={`AWS on-demand Graviton (ARM) prices in us-east-1, provisioned 40% above use for autoscaling. Reserved pricing, spot and credits are lower. Cloudflare and AWS list prices checked ${SITE.verified}.`}>AWS Graviton · us-east-1</Tip>
					</p>
				</div>

				<div class="rule-dash mt-4"></div>
				<div class="grid grid-cols-[minmax(0,1fr)_3.75rem_4rem_2.75rem] gap-1.5 py-2 text-[11px] text-ink-faint sm:grid-cols-[minmax(0,1fr)_4rem_4.25rem_3rem] sm:gap-2">
					<span>Item</span><span class="text-right">Cloudflare</span><span class="text-right text-ink">You pay</span><span></span>
				</div>

				<ul data-shown>{shown.map((l) => <Line l={l} />)}</ul>

				<!-- The rest of the receipt, still on the roll. It is printed in full
				     and cut off where the paper meets the roll. -->
				<div id="receipt-more" data-more>
					<ul>{more.map((l) => <Line l={l} />)}</ul>
					<div class="rule-dash mt-2"></div>
					<ul class="py-2">
						<li class="flex justify-between gap-4"><Tip tip={egress.body} align="start">Egress tax</Tip><span class="font-semibold">$0.00 <span class="text-orange-deep">Free</span></span></li>
						<li class="flex justify-between gap-4"><Tip tip={credits.body} align="start">Cloud credits</Tip><span class="font-semibold">Accepted</span></li>
					</ul>
					<div class="rule-dash"></div>
					<div class="barcode mx-auto mt-5 h-9 w-48" aria-hidden="true"></div>
					<p class="mt-2 text-center text-[11px] tracking-[0.12em] text-ink-faint">Keep this for your CFO</p>
				</div>
			</div>

			<!-- The roll. The button is a fixed band centered where the paper meets
			     the roll, so it stays easy to hit while the roll shrinks. -->
			<button type="button" class="roll-hit absolute -inset-x-px top-0 block h-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange" aria-expanded="false" aria-controls="receipt-more" data-roll-hit>
				<span class="roll absolute inset-x-0 top-1/2 block overflow-hidden" data-roll>
					<span class="absolute inset-0" data-roll-lines></span>
					<span class="roll-label absolute inset-x-0 top-1/2 block text-center font-mono text-[10.5px] font-semibold uppercase leading-none tracking-[0.14em] text-ink-faint" data-roll-label>{more.length} more lines ↓</span>
				</span>
			</button>
		</div>
	</div>
</Argument>

<style>
	/* Paper: a hairline outline so the torn edges read on the page, and a soft
	   shadow below. On the receipt, not the paper, so the roll shares it. */
	.receipt {
		filter: drop-shadow(0 0 0.6px rgb(26 25 24 / 0.28)) drop-shadow(0 1px 1px rgb(26 25 24 / 0.06)) drop-shadow(0 10px 18px rgb(26 25 24 / 0.1));
	}
	/* On a dark page the paper reads by itself; it needs a deeper shadow. */
	:global(.dark) .receipt {
		filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.35)) drop-shadow(0 12px 22px rgb(0 0 0 / 0.5));
	}
	/* Torn edges. The bottom one is the end of the paper, the last thing to
	   come off the roll. */
	.paper::before,
	.paper::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 10px;
	}
	.paper::before {
		bottom: 100%;
		background:
			linear-gradient(45deg, #fffdf8 50%, transparent 50%) 0 100% / 14px 10px repeat-x,
			linear-gradient(-45deg, #fffdf8 50%, transparent 50%) 0 100% / 14px 10px repeat-x;
	}
	.paper::after {
		top: 100%;
		background:
			linear-gradient(135deg, #fffdf8 50%, transparent 50%) 0 0 / 14px 10px repeat-x,
			linear-gradient(-135deg, #fffdf8 50%, transparent 50%) 0 0 / 14px 10px repeat-x;
	}
	.rule-dash {
		border-top: 1.5px dashed color-mix(in srgb, var(--color-ink) 22%, transparent);
	}
	.barcode {
		background: repeating-linear-gradient(90deg, #1a1918 0 2px, transparent 2px 4px, #1a1918 4px 5px, transparent 5px 8px, #1a1918 8px 11px, transparent 11px 12px, #1a1918 12px 13px, transparent 13px 17px);
	}

	/* The roll: a cylinder of the same paper, lit from above and seen side on.
	   The script sets its radius (--r), where it sits, and the creases that
	   show it turning. */
	.roll-hit {
		--r: 14px;
	}
	.roll {
		height: calc(var(--r) * 2);
		margin-top: calc(var(--r) * -1);
		border-radius: min(3px, var(--r)) / var(--r);
		background: linear-gradient(180deg, #cbc4b6 0%, #ebe6db 13%, #fffdf8 30%, #fbf8f1 50%, #e9e3d7 72%, #c5bdae 90%, #aaa291 100%);
		box-shadow: 0 calc(var(--r) * 0.3) calc(var(--r) * 0.45) calc(var(--r) * -0.1) rgb(26 25 24 / 0.32);
	}
	/* Just above the roll the paper curls under it, into its shadow. */
	.roll-hit::before {
		content: '';
		position: absolute;
		left: 1px;
		right: 1px;
		bottom: calc(50% + var(--r));
		height: calc(var(--r) * 0.8);
		background: linear-gradient(to bottom, transparent, rgb(26 25 24 / 0.07));
		pointer-events: none;
	}
	.roll-label {
		transform: translateY(-50%);
		transform-origin: 50% 50%;
	}

	/* Without the script the receipt stays folded: the printed lines and the
	   torn edge, no roll. */
	.receipt:not([data-ready]) [data-more],
	.receipt:not([data-ready]) .roll-hit {
		display: none;
	}
</style>

<script>
	// One number, p, says how much paper is off the roll: 0 rolled up, 1 all
	// out. The rest follows from it. The paper is cut off at the roll's center
	// line, where it wraps around the back of the roll, and the roll rides that
	// line down. The roll holds what paper is left, so its radius shrinks as
	// r = r0 · √(1 − p), slowly at first and to nothing at the paper's end.
	// The creases on its face turn by the paper fed out over the radius, so a
	// small roll spins faster. Reduced motion jumps p straight to the end.
	const reduced = matchMedia('(prefers-reduced-motion: reduce)');
	const canHover = matchMedia('(hover: hover)');
	const R0 = 14; // roll radius, rolled up
	const GAP = 4; // paper showing between the last line and the roll
	const BAND = 40; // the button's height
	const TORN = 10; // the torn edge hangs below the paper's box
	const CREASES = 12;
	const MS = 950;
	const ease = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);

	for (const wrap of document.querySelectorAll<HTMLElement>('[data-receipt-wrap]')) {
		const receipt = wrap.querySelector<HTMLElement>('[data-receipt]')!;
		const paper = receipt.querySelector<HTMLElement>('[data-paper]')!;
		const shown = paper.querySelector<HTMLElement>('[data-shown]')!;
		const hit = receipt.querySelector<HTMLButtonElement>('[data-roll-hit]')!;
		const roll = hit.querySelector<HTMLElement>('[data-roll]')!;
		const creases = hit.querySelector<HTMLElement>('[data-roll-lines]')!;
		const label = hit.querySelector<HTMLElement>('[data-roll-label]')!;
		receipt.toggleAttribute('data-ready', true);

		// y0: where the paper meets the roll, rolled up. y1: its torn end.
		let y0 = 0, y1 = 0, box = 0, p = 0;
		const measure = () => {
			box = paper.offsetHeight;
			y0 = shown.offsetTop + shown.offsetHeight + GAP + R0;
			y1 = box + TORN;
			// The receipt floats over the page and the wrapper keeps its rolled-up
			// height, so the paper prints over the next section instead of pushing
			// it down. Nothing outside the receipt moves.
			wrap.style.height = `${receipt.offsetTop + y0 + R0 + 20}px`;
		};

		const render = () => {
			const y = y0 + (y1 - y0) * p;
			const r = R0 * Math.sqrt(Math.max(0, 1 - p));
			paper.style.clipPath = `inset(-400px -400px ${box - y}px -400px)`;
			hit.style.transform = `translateY(${y - BAND / 2}px)`;
			hit.style.setProperty('--r', `${r.toFixed(2)}px`);
			roll.style.visibility = r < 0.4 ? 'hidden' : '';

			const turn = ((2 * (y1 - y0)) / R0) * (1 - r / R0);
			const fade = Math.min(1, r / 6);
			const layers: string[] = [];
			for (let i = 0; i < CREASES; i++) {
				const a = turn + (i / CREASES) * 2 * Math.PI;
				const c = Math.cos(a);
				if (c < 0.08) continue;
				const ly = r + r * Math.sin(a);
				const ink = `rgb(26 25 24 / ${(0.1 * c * fade).toFixed(3)})`;
				layers.push(`linear-gradient(transparent ${(ly - 0.5).toFixed(2)}px, ${ink} ${(ly - 0.5).toFixed(2)}px ${(ly + 0.5).toFixed(2)}px, transparent ${(ly + 0.5).toFixed(2)}px)`);
			}
			creases.style.backgroundImage = layers.join(', ');

			// The label is printed on the roll and turns away with it.
			const c = turn < Math.PI / 2 ? Math.cos(turn) : 0;
			label.style.opacity = c.toFixed(3);
			label.style.transform = `translateY(calc(-50% + ${(r * Math.sin(Math.min(turn, Math.PI / 2))).toFixed(2)}px)) scaleY(${c.toFixed(3)})`;
		};

		// Ease p toward 0 or 1. A change of mind mid-roll starts from where it is.
		let from = 0, to = 0, start = 0, dur = 0, raf = 0;
		const tick = (now: number) => {
			const k = Math.min(1, (now - start) / dur);
			p = from + (to - from) * ease(k);
			render();
			raf = k < 1 ? requestAnimationFrame(tick) : 0;
		};
		const rollTo = (open: boolean) => {
			hit.setAttribute('aria-expanded', String(open));
			const target = open ? 1 : 0;
			if (target === to) return;
			to = target;
			if (reduced.matches) {
				cancelAnimationFrame(raf);
				raf = 0;
				p = to;
				render();
				return;
			}
			from = p;
			start = performance.now();
			dur = MS * Math.max(0.4, Math.abs(to - from));
			if (!raf) raf = requestAnimationFrame(tick);
		};

		// Open while a mouse is over it, while keyboard focus is inside, or after
		// a tap until the next tap.
		let hover = false, focus = false, pinned = false;
		const update = () => rollTo(hover || focus || pinned);
		wrap.addEventListener('mouseenter', () => {
			if (!canHover.matches) return;
			hover = true;
			update();
		});
		wrap.addEventListener('mouseleave', () => {
			hover = pinned = false;
			update();
		});
		wrap.addEventListener('focusin', (e) => {
			if (!(e.target as HTMLElement).matches(':focus-visible')) return;
			focus = true;
			update();
		});
		wrap.addEventListener('focusout', (e) => {
			if (wrap.contains(e.relatedTarget as Node | null)) return;
			focus = false;
			update();
		});
		// A click rolls it up again, except under a mouse, where hover rules.
		hit.addEventListener('click', () => {
			if (to === 1 && !hover) focus = pinned = false;
			else pinned = true;
			update();
		});
		document.addEventListener('pointerdown', (e) => {
			if (!pinned || wrap.contains(e.target as Node)) return;
			pinned = false;
			update();
		});

		measure();
		render();
		new ResizeObserver(() => {
			measure();
			render();
		}).observe(paper);
	}
</script>
