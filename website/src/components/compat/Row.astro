---
// One row of a list, on the shared six-column grid: chevron, `status`, `name`,
// `a`, `b`, and a right-aligned `end`. The default slot is the detail that
// opens on click; a row without one is static.
interface Props {
	id?: string;
	class?: string;
	hidden?: boolean;
	[key: `data-${string}`]: string | undefined;
}

const { id, class: className = '', hidden = false, ...rest } = Astro.props;
const hasDetail = Astro.slots.has('default');
---

{hasDetail ? (
	<details class={`row scroll-mt-24 ${className}`} id={id} hidden={hidden} {...rest}>
		<summary class="row-cols">
			<svg class="chev" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
			<span><slot name="status" /></span>
			<span><slot name="name" /></span>
			<span><slot name="a" /></span>
			<span><slot name="b" /></span>
			<span><slot name="end" /></span>
		</summary>
		<div class="row-detail"><slot /></div>
	</details>
) : (
	<div class={`row scroll-mt-24 ${className}`} id={id} hidden={hidden} {...rest}>
		<div class="row-cols">
			<span></span>
			<span><slot name="status" /></span>
			<span><slot name="name" /></span>
			<span><slot name="a" /></span>
			<span><slot name="b" /></span>
			<span><slot name="end" /></span>
		</div>
	</div>
)}
