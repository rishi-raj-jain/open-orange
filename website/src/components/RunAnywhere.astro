---
import Argument from '@/components/Argument.astro';
import { DEPLOY_TARGETS, SITE } from '@/data/site';

// Lucide icons (cloud, lock, server), one per deployment option.
const ICONS: Record<string, string> = {
	'rivet-cloud': '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
	byoc: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
	'self-host': '<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>',
};
---

<Argument
	id="where"
	split
	heading="Run it where you want."
	lede="Next to your database, in the cloud and region you choose."
	link={{ label: 'Deployment documentation', href: SITE.docsDeploy }}
>
	{/* At sm and up each card spans five shared rows (icon, label, tagline,
	    runs on, operated by) through subgrid, so the divider and both labels
	    line up across cards however the text wraps. */}
	<ul class="card grid divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
		{DEPLOY_TARGETS.map((target) => (
			<li class="flex flex-col p-6 sm:row-span-5 sm:grid sm:grid-rows-subgrid">
				<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-paper-mid text-ink" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[target.id]} />
				</span>
				<h3 class="mt-5 text-[17px] font-semibold tracking-[-0.01em]">{target.label}</h3>
				<p class="mt-0.5 text-[14px] text-ink-faint">{target.tagline}</p>
				<dl class="mt-6 space-y-4 border-t border-line pt-5 text-[14px] leading-snug sm:row-span-2 sm:grid sm:grid-rows-subgrid">
					<div>
						<dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Runs on</dt>
						<dd class="mt-1">{target.runsOn}</dd>
					</div>
					<div>
						<dt class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-faint">Operated by</dt>
						<dd class="mt-1">{target.operatedBy}</dd>
					</div>
				</dl>
			</li>
		))}
	</ul>
</Argument>
