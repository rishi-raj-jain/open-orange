---
// The OpenOrange logo: a glossy orange half with a leaf, on a transparent
// background so it reads the same on light and dark surfaces.
interface Props {
	class?: string;
	size?: number;
}
const { class: className = '', size = 24 } = Astro.props;
---

<img class={className} src="/images/logo.png" width={size} height={size} alt="" aria-hidden="true" decoding="async" />
