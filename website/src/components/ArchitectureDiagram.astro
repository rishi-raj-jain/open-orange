---
// How OpenOrange runs, top to bottom: your code in standard Docker containers
// in any cloud, connecting out to the Rivet control plane, which is backed by
// S3. Built from HTML and theme tokens rather than a fixed-size SVG, so it
// reflows at phone width and follows light and dark.
// Each orange square in a container is one Rivet Actor; the counts differ to
// show Rivet spreading them across containers. The legend explains the colors.
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;

const containers = [4, 3, 5];
const clouds = 'AWS · Google Cloud · Azure · your servers';
---

<div class={`arch text-ink ${className}`}>
	<!-- Your cloud: the containers orange deploy builds. -->
	<div class="rounded-xl border border-dashed border-ink/25 p-3 sm:p-5">
		<p class="flex flex-wrap items-baseline gap-x-2 text-[12px] font-semibold text-ink-faint">
			<span>Any cloud</span>
			<span class="font-normal">{clouds}</span>
		</p>
		<ul class="mt-3 grid grid-cols-3 gap-2 sm:gap-4">
			{containers.map((actors) => (
				<li class="rounded-lg border-[1.5px] border-orange bg-surface p-2.5 sm:p-4">
					<p class="font-mono text-[11px] text-ink-faint sm:text-[12px]"><span class="hidden sm:inline">Docker </span>container</p>
					<p class="mt-1 hidden text-[14px] font-medium leading-snug sm:block">Workers + Durable Objects</p>
					<p class="mt-0.5 hidden text-[13px] text-ink-soft sm:block">on Node.js</p>
					<span class="mt-3 flex flex-wrap gap-1 sm:gap-1.5" aria-hidden="true">
						{Array.from({ length: actors }, () => <span class="size-2 rounded-[2px] bg-orange sm:size-2.5" />)}
					</span>
				</li>
			))}
		</ul>
		<p class="mt-3 text-[13px] leading-snug text-ink-soft sm:hidden">Each holds your Workers, Durable Objects and the rest of your Cloudflare code, on Node.js.</p>
	</div>

	<!-- Each container connects out to Rivet. -->
	<div class="grid grid-cols-3 gap-2 px-3 sm:gap-4 sm:px-5" aria-hidden="true">
		{containers.map((_, i) => (
			<div class="relative flex justify-center text-ink-faint">
				<svg class="h-11 w-3" viewBox="0 0 12 44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 1v40" /><path d="M2 36l4 5 4-5" /></svg>
				{i === 0 ? <span class="absolute left-[calc(50%+12px)] top-1/2 -translate-y-1/2 whitespace-nowrap text-[12px]">connect out</span> : null}
			</div>
		))}
	</div>

	<!-- The control plane. Plates stay dark in both themes. -->
	<div class="rounded-xl border border-plate bg-plate p-4 text-white dark:border-white/15 sm:flex sm:items-center sm:justify-between sm:gap-6 sm:p-5">
		<div>
			<p class="text-[16px] font-semibold tracking-[-0.01em] sm:text-[17px]">Rivet control plane</p>
			<p class="mt-1 max-w-xl text-[13px] leading-snug text-white/70 sm:text-[14px]">Places each Actor on one of your containers, routes requests to it, and scales the load across them.</p>
		</div>
		<p class="mt-3 shrink-0 text-[12px] text-white/60 sm:mt-0">Open source · self-hosted, Rivet Cloud or BYOC</p>
	</div>

	<div class="flex justify-center text-ink-faint" aria-hidden="true">
		<div class="relative">
			<svg class="h-11 w-3" viewBox="0 0 12 44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 1v40" /><path d="M2 36l4 5 4-5" /></svg>
			<span class="absolute left-[calc(50%+12px)] top-1/2 -translate-y-1/2 whitespace-nowrap text-[12px]">backed by</span>
		</div>
	</div>

	<!-- Storage: S3. -->
	<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 rounded-xl border border-line bg-paper-mid px-4 py-3 sm:px-5">
		<p class="text-[15px] font-semibold">S3</p>
		<p class="text-[13px] text-ink-soft">Cheap, durable and scalable</p>
	</div>

	<!-- Legend. -->
	<ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-ink-soft">
		<li class="flex items-center gap-2"><span class="size-3 shrink-0 rounded-[3px] border-[1.5px] border-orange" aria-hidden="true" /><span>Your code, built into an image by <code class="whitespace-nowrap font-mono text-[12px]">orange deploy</code></span></li>
		<li class="flex items-center gap-2"><span class="size-2.5 shrink-0 rounded-[2px] bg-orange" aria-hidden="true" />One Rivet Actor, such as a Durable Object</li>
		<li class="flex items-center gap-2"><span class="size-3 shrink-0 rounded-[3px] border border-plate bg-plate dark:border-white/30" aria-hidden="true" />Rivet</li>
		<li class="flex items-center gap-2"><span class="size-3 shrink-0 rounded-[3px] border border-ink/20 bg-paper-mid" aria-hidden="true" />Storage</li>
	</ul>
</div>
