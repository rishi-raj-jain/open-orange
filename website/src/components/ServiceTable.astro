---
// The full Cloudflare → OpenOrange mapping, in the AI context of
// /docs/architecture/ (docs/architecture.mdx). `not-prose` keeps the docs
// typography off it.
import ProviderList from '@/components/ProviderList.astro';
import { SERVICE_MAP, STATUS_LABEL, type ServiceStatus } from '@/data/site';

const statusClass: Record<ServiceStatus, string> = {
	'drop-in': 'chip-good',
	pluggable: 'chip-neutral',
	partial: 'chip-neutral',
	planned: 'chip-muted',
};
---

<div class="not-prose card my-5 overflow-hidden leading-normal">
	<div class="overflow-x-auto">
		<table class="w-full min-w-[800px] border-collapse text-left text-[14px]">
			<thead>
				<tr class="border-b border-line bg-paper-mid text-[12px] font-semibold text-ink-faint">
					<th class="px-5 py-3 font-semibold">Cloudflare</th>
					<th class="px-5 py-3 font-semibold">OpenOrange</th>
					<th class="px-5 py-3 font-semibold">Status</th>
					<th class="px-5 py-3 font-semibold">Notes</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-line">
				{SERVICE_MAP.map((row) => (
					<tr class="align-top">
						<td class="px-5 py-4 font-semibold">{row.cloudflare}</td>
						<td class="px-5 py-4 font-medium">
							{row.openorange}
							{row.providers ? (
								<div class="mt-2 font-normal">
									<ProviderList slug={row.providers} />
								</div>
							) : null}
						</td>
						<td class="px-5 py-4"><span class={statusClass[row.status]}>{STATUS_LABEL[row.status]}</span></td>
						<td class="px-5 py-4 text-ink-soft">{row.detail}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
	<p class="caption border-t border-line bg-paper-mid px-5 py-3">
		Drop-in: the binding API works unchanged. Pluggable: the binding works unchanged and you choose the backend. Partial: it runs, but some documented APIs throw or act differently. Not supported: calls throw.
	</p>
</div>
