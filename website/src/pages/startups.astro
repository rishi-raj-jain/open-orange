---
import Base from '@/layouts/Base.astro';
import Cta from '@/components/Cta.astro';
import CashRain from '@/components/CashRain.astro';
import { CREDITS, CREDITS_TOTAL, SITE } from '@/data/site';

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
const max = Math.max(...CREDITS.map((c) => c.amount));
const points = [
	{
		title: 'Credit surfing without a rewrite',
		body: "Start on Google's credits. When they run out, openorange deploy --cluster to a cluster on another cloud. Same config, same code.",
	},
	{
		title: 'Your model spend and your compute in one account',
		body: 'Bedrock, Vertex and Azure OpenAI draw from the same credit pool as your instances.',
	},
	{
		title: 'No usage surprises at month end',
		body: 'A VM costs the same on launch day as on a quiet day.',
	},
	{
		title: 'Where does the data live?',
		body: '"In our VPC on AWS." It shortens SOC 2, HIPAA and procurement reviews.',
	},
] as const;
---

<Base
	title={`${SITE.name} for startups — spend the cloud credits you already have`}
	description={`AWS, Google Cloud and Azure offer up to ${usd(CREDITS_TOTAL)} in startup credits combined. OpenOrange lets a Cloudflare Workers project run on them.`}
>
	<section class="relative isolate overflow-hidden cursor-pointer select-none" data-cash-hero>
		<div class="absolute inset-y-0 right-0 w-full lg:left-[58%] lg:w-auto"><CashRain /></div>
		<div class="container-x relative z-10 pt-20 pb-20 md:pt-28 md:pb-28">
			<div class="w-fit max-w-3xl rounded-2xl bg-surface/95 p-3 sm:-mx-4 sm:p-4 lg:bg-transparent lg:p-0 lg:-mx-0">
				<h1 class="h-hero">
					Unlock over {usd(CREDITS_TOTAL)} in credits.
				</h1>
				<p class="lede mt-7 max-w-xl">
					AWS, Google and Azure give startups six figures of compute each. Workers cannot spend it. OpenOrange can.
				</p>
			</div>
		</div>
	</section>

	<section class="rule">
		<div class="container-x section grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-20">
			<figure class="card self-start p-6 md:p-8">
				<figcaption class="label">Startup credit programs, maximum tier</figcaption>
				<div class="mt-6 space-y-5">
					{CREDITS.map((credit) => (
						<div>
							<div class="flex items-baseline justify-between gap-4 text-[14px] font-medium">
								<a href={credit.href} class="hover:text-orange-deep" rel="noopener">{credit.cloud}</a>
								<span class="font-mono tabular-nums text-ink-soft">up to {usd(credit.amount)}</span>
							</div>
							<div class="mt-2 h-3 w-full overflow-hidden rounded-full bg-line" role="img" aria-label={`${credit.cloud}: up to ${usd(credit.amount)}`}>
								<div class="h-full rounded-full bg-orange" style={`width:${Math.round((credit.amount / max) * 100)}%`}></div>
							</div>
							<p class="caption mt-1.5">{credit.note}</p>
						</div>
					))}
				</div>
				<p class="caption mt-6">
					Published maximums, checked {SITE.verified}. Tiers depend on stage and referral.
				</p>
			</figure>

			<ul class="divide-y divide-line">
				{points.map((point, i) => (
					<li class={i === 0 ? 'pb-7' : 'py-7'}>
						<h2 class="h-card">{point.title}</h2>
						<p class="body-copy mt-2 text-ink-soft">{point.body}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<Cta
		title="Build on the credits, not around them."
		body="Two commands. Whichever cloud is paying."
	/>
</Base>
