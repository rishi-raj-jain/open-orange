---
import { Code } from 'astro:components';
import { getEntry } from 'astro:content';
import Docs from '@/layouts/Docs.astro';
import { docHref } from '@/components/docs/nav';
import { DOCS_PAGES } from '@/data/docs-pages';


// The quickstart follows the repository README. Everything else on /docs/
// renders from docs/*.mdx.
const steps = [
	{
		title: 'Install',
		body: 'Install the `orange` CLI globally, then run it in your Worker project. Your code and your Wrangler configuration do not change.',
		code: 'pnpm add -g open-orange',
	},
	{
		title: 'Run your Worker',
		body: 'Your Worker answers on `http://localhost:8787`. Each Durable Object runs as a Rivet Actor with its own SQLite database, kept in `.open-orange/`.',
		code: 'orange dev',
	},
	{
		title: 'Deploy',
		body: '`orange deploy` builds an image of your Worker and rolls it out to a Rivet cluster, then prints its public URL.',
		code: 'orange login\norange link --cluster <cluster-name>\norange deploy',
		more: { label: 'Deploy guide', href: docHref('deploy') },
	},
	{
		title: 'Move your data from Cloudflare',
		body: '`orange migrate` moves Durable Objects and D1 databases while your app serves. Skip this step if your app has no data on Cloudflare.',
		code: 'orange migrate prepare\norange migrate backfill --url https://app.example.com',
		more: { label: 'Migration guide', href: docHref('migrate') },
	},
];

// Text in backticks renders as code: odd parts are code.
const codeParts = (text: string) => text.split(/`([^`]+)`/);

const sections = await Promise.all(
	['deploy', 'migrate', 'modules', 'modules/bindings', 'operations/monitoring', 'errors'].map(async (id) => {
		const entry = (await getEntry('docs', id))!;
		if (id === 'modules') return { href: docHref(id), title: 'Bindings', description: 'Every Cloudflare binding on OpenOrange: whether it runs, how, and what differs from Cloudflare.' };
		if (id === 'operations/monitoring') return { href: docHref(id), title: 'Operations', description: 'Monitor, debug, and run your app in production: traces, metrics, logs, regions, and limits.' };
		return { href: docHref(id), title: id === 'modules/bindings' ? 'Binding configuration' : entry.data.title, description: entry.data.description };
	}),
);
---

<Docs
	title={DOCS_PAGES['/docs/'].title}
	description={DOCS_PAGES['/docs/'].description}
	headTitle="OpenOrange documentation"
	href="/docs/"
	headings={[
		{ depth: 2, slug: 'quickstart', text: 'Quickstart' },
		{ depth: 2, slug: 'explore', text: 'Explore the docs' },
	]}
>
	<p>
		OpenOrange reads your Wrangler configuration and runs the same Worker on Node.js. Each Durable Object runs as a <a href="https://rivet.dev/docs/actors/">Rivet Actor</a> with its own SQLite database.
	</p>

	<h2 id="quickstart">Quickstart</h2>
	<p>You need a Worker project with a <code>wrangler.jsonc</code>, <code>wrangler.json</code>, or <code>wrangler.toml</code>, Node.js 22 or later, and pnpm. Deploying also needs Docker.</p>

	{steps.map((step, i) => (
		<>
			<h3 id={`step-${i + 1}`}>Step {i + 1}: {step.title}</h3>
			<p>{codeParts(step.body).map((part, j) => (j % 2 ? <code>{part}</code> : part))}{step.more && <> See the <a href={step.more.href}>{step.more.label.toLowerCase()}</a>.</>}</p>
			<Code code={step.code} lang="sh" themes={{ light: 'github-light', dark: 'github-dark' }} />
		</>
	))}

	<h2 id="explore">Explore the docs</h2>
	<ul class="not-prose !my-6 grid !list-none gap-3 !pl-0 sm:grid-cols-2">
		{sections.map((section) => (
			<li class="!my-0 !pl-0">
				<a href={section.href} class="card block h-full px-5 py-4 !no-underline transition-colors hover:border-ink/30">
					<span class="flex items-center justify-between gap-3 font-medium text-ink">{section.title}<span class="text-ink-faint" aria-hidden="true">→</span></span>
					<span class="mt-1 block text-[14px] font-normal leading-[1.55] text-ink-soft">{section.description}</span>
				</a>
			</li>
		))}
	</ul>
</Docs>
