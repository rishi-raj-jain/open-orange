---
// Bindings overview: one row per Cloudflare binding, pointing at what it runs
// on in OpenOrange. Status, config keys, notes and test results live on each
// binding's own page (BindingDetail), so this page stays a map.
import Docs from '@/layouts/Docs.astro';
import { BINDINGS, bindingPage, type Binding } from '@/data/bindings';
import { PRODUCT_LABEL, TONE_CLASS, inline, type ProductStatus } from '@/data/conformance';
import { docRoute } from '@/components/docs/routes';

// Where each binding runs, in a few words, after the service map on
// /architecture/ and the `orange` field of compat/products.json. A binding
// missing here shows its full `orange` text instead. Stubs name what to use.
const RUNS_ON: Record<string, string> = {
	workers: 'The OpenOrange runtime on Node.js',
	'durable-objects': 'Rivet Actors',
	kv: 'A Rivet Actor per namespace',
	d1: 'A SQLite database in a Rivet Actor',
	r2: 'A Rivet Actor, or any S3-compatible store',
	queues: 'A Rivet Actor per queue',
	workflows: "Cloudflare's own Workflows engine on Rivet Actors",
	'cron-triggers': 'Rivet Actor schedules',
	'rate-limiting': 'A fixed-window counter in a Rivet Actor',
	'workers-ai': 'Any OpenAI-compatible endpoint',
	'cache-api': 'A Rivet Actor per cache name',
	'durable-object-facets': 'A child Rivet Actor per facet',
	'worker-loader': 'A Node.js process per dynamic Worker, in an agentOS VM',
	'service-bindings': 'Other Workers in the same orange dev session',
	'dispatch-namespaces': 'User Workers in the same orange dev session',
	sandboxes: 'Your sandbox provider',
	containers: 'A sandbox per object, on your sandbox provider',
	'browser-rendering': 'Your headless Chrome or a hosted browser',
	'send-email': 'Your SMTP server',
	hyperdrive: 'A direct connection to your database',
	'analytics-engine': 'A dataset that drops every data point',
	vectorize: 'Use a vector database over `fetch()`',
	images: 'Use an image service such as imgproxy',
	pipelines: 'Not built yet',
	'ai-search': 'Not built yet',
	'mtls-certificates': 'Not built yet',
	vpc: 'Use `fetch()` to reach the host network',
	'legacy-blobs': 'Import the file from the Worker source',
};

// Shorter names where the product name runs long.
const NAME: Record<string, string> = {
	'service-bindings': 'Service bindings',
	'dispatch-namespaces': 'Workers for Platforms',
};

const LEGEND: { id: ProductStatus; meaning: string }[] = [
	{ id: 'drop-in', meaning: 'nothing to change' },
	{ id: 'pluggable', meaning: 'you pick the provider' },
	{ id: 'partial', meaning: 'known differences' },
	{ id: 'stub', meaning: 'every call throws' },
];

const working = BINDINGS.filter((b) => b.product.status !== 'stub');
const rows = [...working, ...BINDINGS.filter((b) => b.product.status === 'stub')];

// A row opens its binding's page at the top. When a page covers several
// bindings, the later ones (and every binding on the shared configuration
// page) jump to their own section of it.
const configuration = docRoute('modules/bindings');
const taken = new Set<string>();
const hrefs = new Map<string, string | undefined>(
	BINDINGS.map((b: Binding) => {
		const page = bindingPage(b);
		if (!page) return [b.slug, undefined];
		if (page === configuration || taken.has(page)) return [b.slug, `${page}#${b.slug}`];
		taken.add(page);
		return [b.slug, page];
	}),
);
---

<Docs
	title="Bindings overview"
	description={`${working.length} of ${BINDINGS.length} Cloudflare bindings run on OpenOrange, with the same wrangler.jsonc and the same env. Here is where each one runs. Its page has what differs and the tests behind it.`}
	href="/docs/bindings/"
	prose={false}
	wide
>
	<ul class="legend" aria-label="Status">
		{LEGEND.map((l) => (
			<li>
				<span class={`${TONE_CLASS[PRODUCT_LABEL[l.id].tone].dot} size-1.5`}></span>
				<span class="font-medium text-ink-soft">{PRODUCT_LABEL[l.id].label}</span>
				{l.meaning}
			</li>
		))}
	</ul>

	<ul class="map mt-5">
		{rows.map((b) => {
			const s = PRODUCT_LABEL[b.product.status];
			const href = hrefs.get(b.slug);
			const cells = (
				<>
					<span class="map-name">{NAME[b.slug] ?? b.product.product}</span>
					<span class="map-arrow" aria-hidden="true">→</span>
					<span class:list={['map-to', b.product.status === 'stub' && 'is-stub']}>
						<span class="sr-only">runs on </span>
						<Fragment set:html={inline(RUNS_ON[b.slug] ?? b.product.orange)} />
					</span>
					<span class="map-status">
						<span class={`${TONE_CLASS[s.tone].dot} size-1.5`}></span>
						{s.label}
					</span>
				</>
			);
			return (
				<li id={b.slug} class="map-row">
					{href ? <a href={href} class="map-cells">{cells}</a> : <div class="map-cells">{cells}</div>}
				</li>
			);
		})}
	</ul>

	<p class="caption mt-6">Test results for every binding are on the <a href="/compatibility/" class="link">compatibility page</a>.</p>
</Docs>

<style>
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 13px;
		line-height: 1.5;
		color: var(--color-ink-faint);
	}
	.legend > li {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	/* Rows share one grid through subgrid, so every arrow lines up after the
	   longest binding name: name, arrow, target, status. */
	.map {
		display: grid;
		grid-template-columns: auto auto minmax(0, 1fr) auto;
		column-gap: 1rem;
		border-top: 1px solid var(--color-line);
	}
	.map-row {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		border-bottom: 1px solid var(--color-line);
		scroll-margin-top: 6rem;
	}
	.map-cells {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		align-items: baseline;
		padding: 0.6875rem 0.5rem;
		transition: background-color 150ms;
	}
	a.map-cells:hover {
		background-color: color-mix(in srgb, var(--color-paper-mid) 60%, transparent);
	}
	a.map-cells:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: -2px;
		border-radius: 0.375rem;
	}
	.map-row:target > .map-cells {
		background-color: var(--color-orange-soft);
	}
	.map-name {
		font-size: 14.5px;
		font-weight: 500;
		line-height: 1.4;
		color: var(--color-ink);
	}
	.map-arrow {
		color: var(--color-ink-faint);
		transition:
			color 150ms,
			transform 150ms;
	}
	a.map-cells:hover .map-arrow {
		color: var(--color-orange);
		transform: translateX(2px);
	}
	.map-to {
		min-width: 0;
		font-size: 14px;
		line-height: 1.4;
		color: var(--color-ink-soft);
		overflow-wrap: anywhere;
	}
	.map-to.is-stub {
		color: var(--color-ink-faint);
	}
	.map-to :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
	.map-status {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		justify-self: end;
		white-space: nowrap;
		font-size: 12px;
		color: var(--color-ink-faint);
	}
	@media (prefers-reduced-motion: reduce) {
		.map-cells,
		.map-arrow {
			transition: none;
		}
	}

	/* Phones: the name and status on one line, the arrow and target under them. */
	@media (max-width: 639px) {
		.map,
		.map-row {
			display: block;
		}
		.map-cells {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			grid-template-areas:
				'name name status'
				'arrow to to';
			column-gap: 0.5rem;
			row-gap: 0.125rem;
			padding-inline: 0.25rem;
		}
		.map-name {
			grid-area: name;
		}
		.map-arrow {
			grid-area: arrow;
		}
		.map-to {
			grid-area: to;
		}
		.map-status {
			grid-area: status;
		}
	}
</style>
