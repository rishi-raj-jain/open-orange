---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/data/site';
import { SITE_OG_IMAGE } from '@/og/paths';
// The same hashed files as the @font-face rules in global.css.
import interUrl from '@/assets/fonts/inter/Inter-Variable-latin.woff2?url';
import monoUrl from '@/assets/fonts/jetbrains-mono/JetBrainsMono-Variable-latin.woff2?url';

interface Props {
	title: string;
	description?: string;
	/** Site path of the page's 1200×630 Open Graph image (src/pages/og*). Defaults to the site-wide card. */
	image?: string;
	/** `article` for docs pages. */
	type?: 'website' | 'article';
	/** Keep the page out of search results. Also leave it out of the sitemap (astro.config.ts). */
	noindex?: boolean;
	/** schema.org objects for the page, rendered as JSON-LD. */
	structuredData?: Record<string, unknown>[];
}

const { title, description = SITE.description, image = SITE_OG_IMAGE, type = 'website', noindex = false, structuredData = [] } = Astro.props;
const origin = Astro.site ?? `https://${SITE.domain}`;
// Always the production origin, so previews and aliases point search engines at openorange.dev.
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(image, origin).href;
// `<` escaped so text in the data can't close the script element.
const jsonLd = structuredData.length
	? JSON.stringify({ '@context': 'https://schema.org', '@graph': structuredData }).replaceAll('<', '\\u003c')
	: undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Theme before paint: the toggle's saved choice (Nav.astro), else the system setting. -->
		<script is:inline>
			try {
				var t = localStorage.getItem('theme');
				if (t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
			} catch (e) {}
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="theme-color" content="#F26B1D" />
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={title} />
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
	</head>
	<body class="flex min-h-screen flex-col overflow-x-clip">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-plate focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
		<Nav />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer />
		<script>
			// Copy buttons: any element with data-copy copies its value. Only after the
			// copy succeeds does its [data-copy-label] read "Copied" and the element
			// get data-copied (for styling), both for 1.5 s.
			const copyTimers = new WeakMap<HTMLElement, number>();
			const writeClipboard = async (value: string) => {
				try {
					await navigator.clipboard.writeText(value);
					return true;
				} catch {
					// No Clipboard API outside a secure context, such as the dev server
					// opened by IP address: fall back to a selected textarea.
				}
				const area = document.createElement('textarea');
				area.value = value;
				area.setAttribute('readonly', '');
				area.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
				document.body.append(area);
				area.select();
				try {
					return document.execCommand('copy');
				} catch {
					return false;
				} finally {
					area.remove();
				}
			};
			document.addEventListener('click', async (event) => {
				const target = (event.target as HTMLElement).closest<HTMLElement>('[data-copy]');
				if (!target) return;
				if (!(await writeClipboard(target.dataset.copy ?? ''))) return;
				const label = target.querySelector<HTMLElement>('[data-copy-label]') ?? target;
				label.dataset.copyOriginal ??= label.textContent ?? '';
				label.textContent = 'Copied';
				// Restart the acknowledgement on a repeat click.
				delete target.dataset.copied;
				void target.offsetWidth;
				target.dataset.copied = '';
				clearTimeout(copyTimers.get(target));
				copyTimers.set(
					target,
					window.setTimeout(() => {
						label.textContent = label.dataset.copyOriginal ?? '';
						delete target.dataset.copied;
					}, 1500),
				);
			});

			// Links that leave the site open in a new tab. GitHub, where the docs live,
			// refuses to load inside a frame and would otherwise show a blank page.
			for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')) {
				if (link.origin === location.origin) continue;
				link.target = '_blank';
				link.rel = 'noopener';
			}
		</script>
	</body>
</html>
