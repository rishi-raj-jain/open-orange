  services = [
    (name = "main", worker = .mainWorker),
    (name = "TEST_TMPDIR", disk = (writable = true)),
  ],
);

const mainWorker :Workerd.Worker = (
  compatibilityFlags = ["nodejs_compat"],
  modules = [
    (name = "worker", esModule = embed "do-alarm-test.js"),
  ],
  durableObjectNamespaces = [
    (className = "TestDurableObject", uniqueKey = "a1a2a3a4a5a6a7a8a9b0b1b2b3b4b5b6", enableSql = true),
  ],
  durableObjectStorage = (localDisk = "TEST_TMPDIR"),
  bindings = [
    (name = "ns", durableObjectNamespace = "TestDurableObject"),
  ],
);
