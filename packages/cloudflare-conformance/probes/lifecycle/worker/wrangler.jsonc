{
	"name": "lifecycle",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"durable_objects": {
		"bindings": [
			{ "name": "ROOM", "class_name": "Room" },
			{ "name": "LEGACY", "class_name": "Legacy" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Room"] },
		{ "tag": "v2", "new_classes": ["Legacy"] }
	],
	"workflows": [{ "name": "flow", "binding": "FLOW", "class_name": "Flow" }]
}
