{
	"name": "scale-units",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"durable_objects": { "bindings": [{ "name": "UNIT", "class_name": "Unit" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Unit"] }],
	"kv_namespaces": [{ "binding": "KV_A", "id": "kv-a" }, { "binding": "KV_B", "id": "kv-b" }],
	"d1_databases": [
		{ "binding": "D1_A", "database_name": "d1-a", "database_id": "d1-a" },
		{ "binding": "D1_B", "database_name": "d1-b", "database_id": "d1-b" }
	],
	"r2_buckets": [{ "binding": "R2_A", "bucket_name": "r2-a" }, { "binding": "R2_B", "bucket_name": "r2-b" }],
	"queues": {
		"producers": [{ "binding": "QUEUE_A", "queue": "queue-a" }, { "binding": "QUEUE_B", "queue": "queue-b" }]
	},
	"ratelimits": [
		{ "name": "LIMIT_A", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
		{ "name": "LIMIT_B", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
	],
	"workflows": [{ "name": "flow", "binding": "FLOW", "class_name": "Flow" }]
}
