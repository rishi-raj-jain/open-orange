{
	"name": "serve-primary", "main": "primary.js", "compatibility_date": "2026-09-03",
	"triggers": { "crons": ["* * * * *"] },
	"kv_namespaces": [{ "binding": "KV", "id": "shared-kv" }],
	"queues": { "producers": [{ "binding": "JOBS", "queue": "serve-jobs" }] },
	"durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter", "script_name": "serve-peer" }] }
}
