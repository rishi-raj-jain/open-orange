{
	"name": "rate-limiting",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"ratelimits": [
		{ "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 10 } },
		{ "name": "USER_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
		// Same namespace_id: both bindings count against the same keys.
		{ "name": "LOGIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
		{ "name": "RESET_LIMITER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
	]
}
