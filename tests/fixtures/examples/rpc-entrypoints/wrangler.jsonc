{
	"name": "rpc-entrypoints",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	// A service binding to this Worker's own Greeter entrypoint.
	"services": [
		{ "binding": "GREETER", "service": "rpc-entrypoints", "entrypoint": "Greeter" }
	],
	"durable_objects": {
		"bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }]
}
