{
	"name": "orange-test-class-migrations", "main": "src/index.js", "compatibility_date": "2026-09-03",
	"durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "NewRoom" }, { "name": "RETIRED", "class_name": "Retired" }] },
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OldRoom", "Retired"] },
		{ "tag": "v2", "renamed_classes": [{ "from": "OldRoom", "to": "NewRoom" }], "deleted_classes": ["Retired"] },
		{ "tag": "v3", "new_sqlite_classes": ["Retired"] }
	]
}
